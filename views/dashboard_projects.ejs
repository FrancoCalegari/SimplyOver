<!DOCTYPE html>
<html class="dark" lang="en">
<%- include('partials/head', {title: title || 'My Projects | SimplyOver'}) %>
<body class="bg-background text-on-background">
    <!-- Navbar -->
    <%- include('partials/navbar') %>

    <div class="flex h-screen pt-16">
        <!-- Sidebar -->
        <%- include('partials/dashboard_sidebar', { activeTab: 'projects' }) %>

        <!-- Main Content -->
        <main class="flex-1 ml-0 md:ml-[280px] overflow-y-auto p-8 lg:p-12">
            <div class="max-w-6xl mx-auto">
                
                <header class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h1 class="text-3xl font-bold text-white mb-1">My Projects</h1>
                        <p class="text-on-surface-variant">Manage overlays you have created and uploaded.</p>
                    </div>
                    <a href="/studio" class="px-6 py-2.5 primary-gradient rounded-xl font-bold text-white shadow-lg shadow-primary/25 hover:brightness-110 hover:scale-105 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">add</span>
                        Upload New
                    </a>
                </header>

                <% if (overlays.length === 0) { %>
                    <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed border-white/5 rounded-3xl">
                        <span class="material-symbols-outlined text-6xl text-on-surface-variant/20 mb-4">folder_open</span>
                        <h2 class="text-xl font-bold text-white mb-2">No projects yet</h2>
                        <p class="text-on-surface-variant mb-6 text-center max-w-sm">You haven't uploaded any overlays to the platform yet. Start creating!</p>
                        <a href="/studio" class="px-6 py-2.5 bg-white/10 hover:bg-white/20 rounded-xl font-bold text-white transition-colors">Publish your first overlay</a>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
                        <% overlays.forEach(function(ov) { 
                            let previewUrl = '/images/placeholder.svg';
                            try {
                                const ids = JSON.parse(ov.preview_storage_ids || '[]');
                                if (ids[0]) previewUrl = '/api/files/' + ids[0];
                            } catch(e) {}
                        %>
                        <div class="glass-surface border border-white/10 rounded-2xl overflow-hidden hover:border-white/20 transition-all flex flex-col group">
                            <!-- Preview Image -->
                            <div class="aspect-video w-full bg-surface-container-high relative overflow-hidden">
                                <img src="<%= previewUrl %>" alt="<%= ov.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='/images/placeholder.svg'">
                                
                                <!-- Status Badge -->
                                <div class="absolute top-3 left-3">
                                    <% if (ov.status === 'APPROVED') { %>
                                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-green-500/20 text-green-400 border border-green-500/30 backdrop-blur-md flex items-center gap-1 shadow-lg shadow-green-500/10">
                                            <span class="material-symbols-outlined text-[12px]">check_circle</span> APPROVED
                                        </span>
                                    <% } else if (ov.status === 'PENDING') { %>
                                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-yellow-500/20 text-yellow-300 border border-yellow-500/30 backdrop-blur-md flex items-center gap-1 shadow-lg shadow-yellow-500/10">
                                            <span class="material-symbols-outlined text-[12px]">schedule</span> IN REVIEW
                                        </span>
                                    <% } else if (ov.status === 'BANNED') { %>
                                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30 backdrop-blur-md flex items-center gap-1 shadow-lg shadow-red-500/10">
                                            <span class="material-symbols-outlined text-[12px]">block</span> BANNED
                                        </span>
                                    <% } else { %>
                                        <span class="px-3 py-1 rounded-full text-[10px] font-bold bg-white/10 text-on-surface-variant border border-white/20 backdrop-blur-md flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[12px]">draft</span> DRAFT
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Action Overlay -->
                                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3 backdrop-blur-[2px]">
                                    <a href="/overlay/<%= ov.slug %>" target="_blank" class="w-10 h-10 rounded-full bg-white/20 hover:bg-primary/80 flex items-center justify-center text-white transition-all" title="View Page">
                                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                                    </a>
                                </div>
                            </div>
                            
                            <!-- Info -->
                            <div class="p-5 flex-1 flex flex-col">
                                <div class="flex justify-between items-start mb-2 gap-2">
                                    <h3 class="font-bold text-white text-lg leading-tight line-clamp-1"><%= ov.name %></h3>
                                    <span class="font-bold text-primary shrink-0"><%= parseFloat(ov.price) > 0 ? '$' + parseFloat(ov.price).toFixed(2) : 'FREE' %></span>
                                </div>
                                <div class="flex items-center gap-4 text-xs text-on-surface-variant mt-auto">
                                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">visibility</span> <%= ov.view_count || 0 %></span>
                                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">download</span> <%= ov.download_count || 0 %></span>
                                    <span class="ml-auto flex items-center gap-1"><span class="material-symbols-outlined text-[14px]">calendar_today</span> <%= new Date(ov.created_at).toLocaleDateString() %></span>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <!-- Success Modal (Published) -->
    <% if (typeof published !== 'undefined' && published) { %>
    <div id="successModal" class="fixed inset-0 bg-black/80 z-[100] flex items-center justify-center p-4 backdrop-blur-sm">
        <div class="glass-surface border border-primary/20 rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl text-center p-8 scale-95 opacity-0 animate-[popIn_0.4s_ease-out_forwards]">
            <div class="w-20 h-20 rounded-full bg-green-500/20 border border-green-500/30 flex items-center justify-center mx-auto mb-6">
                <span class="material-symbols-outlined text-green-400 text-4xl">rocket_launch</span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Published Successfully!</h3>
            <p class="text-on-surface-variant text-sm mb-8">Your project has been sent to the marketplace for review. It usually takes less than 24 hours.</p>
            <button onclick="document.getElementById('successModal').style.display='none'" class="w-full py-3 primary-gradient rounded-xl font-bold text-white shadow-lg hover:brightness-110 transition-all">
                Awesome!
            </button>
        </div>
    </div>
    <style>
        @keyframes popIn {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
    <% } %>
</body>
</html>
