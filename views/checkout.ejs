        <div class="space-y-3">
          <a id="btn-download-token" href="/download/sample"
             class="w-full py-4 px-6 rounded-xl font-bold text-white text-base shadow-xl flex items-center justify-center gap-2 transition-all hover:scale-[1.02] shadow-cyan-500/25"
             style="background: linear-gradient(135deg, #06b6d4 0%, #009ee3 100%);">
            <span class="material-symbols-outlined text-[22px]">download</span>
            <span>Descargar Paquete Overlay (.ZIP)</span>
          </a>

          <div class="grid grid-cols-2 gap-3">
            <a href="/dashboard/library" class="py-3 px-4 rounded-xl text-xs font-bold text-white bg-white/10 hover:bg-white/15 border border-white/10 transition-all flex items-center justify-center gap-1.5">
              <span class="material-symbols-outlined text-[16px]">library_music</span>
              <span>Mi Biblioteca</span>
            </a>
            <button type="button" onclick="openOBSInstructions()" class="py-3 px-4 rounded-xl text-xs font-bold text-secondary bg-secondary/10 hover:bg-secondary/20 border border-secondary/20 transition-all flex items-center justify-center gap-1.5">
              <span class="material-symbols-outlined text-[16px]">help</span>
              <span>¿Cómo instalar en OBS?</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ESTADO RECHAZADO -->
      <div id="rejected-state" class="hidden space-y-6">
        <div class="w-20 h-20 mx-auto rounded-full bg-red-500/20 border-2 border-red-500 flex items-center justify-center text-red-400 shadow-lg shadow-red-500/20">
          <span class="material-symbols-outlined text-4xl">error</span>
        </div>

        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-red-500/15 text-red-400 border border-red-500/30 uppercase tracking-wider mb-2">
            Operación No Autorizada
          </span>
          <h3 class="text-xl font-bold text-white">El pago no pudo procesarse</h3>
          <p id="rejection-reason" class="text-xs text-on-surface-variant mt-2 leading-relaxed">
            Tu tarjeta fue rechazada por la entidad bancaria emisora (Fondos insuficientes o límite de compras por internet excedido).
          </p>
        </div>

        <div class="space-y-3">
          <button type="button" onclick="closePaymentResultModal()"
                  class="w-full py-3.5 px-6 rounded-xl font-bold text-white text-sm bg-white/10 hover:bg-white/15 border border-white/10 transition-all flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">refresh</span>
            <span>Reintentar con otro medio de pago</span>
          </button>
          <a href="/overlay/<%= overlay.slug || overlay.id %>" class="block text-xs text-on-surface-variant hover:text-white transition-colors">
            Volver a la página del overlay
          </a>
        </div>
      </div>

      <!-- ESTADO PENDIENTE -->
      <div id="pending-state" class="hidden space-y-6">
        <div class="w-20 h-20 mx-auto rounded-full bg-amber-500/20 border-2 border-amber-500 flex items-center justify-center text-amber-400 shadow-lg shadow-amber-500/20">
          <span class="material-symbols-outlined text-4xl">hourglass_top</span>
        </div>

        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30 uppercase tracking-wider mb-2">
            Pago Pendiente de Acreditación
          </span>
          <h3 class="text-xl font-bold text-white">Cupón de Pago Generado</h3>
          <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">
            Puedes abonar tu cupón en cualquier sucursal de Rapipago o Pago Fácil. La descarga se activará apenas se acredite el pago.
          </p>
        </div>

        <div class="rounded-xl bg-black/40 border border-white/10 p-4 text-xs font-mono text-left space-y-1">
          <p class="text-white/60">Código de Pago:</p>
          <p id="pending-code" class="text-base text-amber-300 font-bold tracking-wider">2700 8492 0192 8472</p>
        </div>

        <button type="button" onclick="closePaymentResultModal()"
                class="w-full py-3.5 px-6 rounded-xl font-bold text-white text-sm bg-amber-500 hover:bg-amber-600 transition-all flex items-center justify-center gap-2">
          <span>Entendido</span>
        </button>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>

  <!-- ── SCRIPTS DE CONTROL Y LÓGICA DE CHECKOUT ───────────────────────────── -->
  <script>
    // Variables de Estado
    const OVERLAY_ID = "<%= overlay.id %>";
    const BASE_PRICE = <%= parseFloat(overlay.price) %>;
    const MP_PUBLIC_KEY = "<%= mpPublicKey %>";
    const IS_MP_CONFIGURED = <%= mpConfigured ? 'true' : 'false' %>;

    let currentDiscountPercent = 0;
    let selectedOutcome = 'approved';

    // ── Cambio de Métodos de Pago ───────────────────────────────────────────
    function switchMethod(method) {
      document.querySelectorAll('.method-tab').forEach(el => {
        el.classList.remove('bg-[#009ee3]/10', 'border-[#009ee3]', 'text-white', 'active');
        el.classList.add('bg-white/[0.03]', 'border-white/10', 'text-on-surface-variant');
      });
      document.querySelectorAll('.method-content').forEach(el => el.classList.add('hidden'));

      const activeTab = document.getElementById(`tab-btn-${method}`);
      const activeContent = document.getElementById(`content-${method}`);

      if (activeTab) {
        activeTab.classList.remove('bg-white/[0.03]', 'border-white/10', 'text-on-surface-variant');
        activeTab.classList.add('bg-[#009ee3]/10', 'border-[#009ee3]', 'text-white', 'active');
      }
      if (activeContent) {
        activeContent.classList.remove('hidden');
      }
    }

    // ── Cupones de Descuento ────────────────────────────────────────────────
    function applyCoupon() {
      const code = document.getElementById('coupon-input').value.trim().toUpperCase();
      const feedback = document.getElementById('coupon-feedback');
      feedback.classList.remove('hidden', 'text-emerald-400', 'text-red-400');

      if (!code) {
        feedback.innerText = 'Ingresa un código de cupón';
        feedback.classList.add('text-red-400');
        return;
      }

      if (code === 'DEMO50') {
        currentDiscountPercent = 50;
        feedback.innerText = '✓ Cupón DEMO50 aplicado: 50% de descuento';
        feedback.classList.add('text-emerald-400');
      } else if (code === 'STREAMER100') {
        currentDiscountPercent = 100;
        feedback.innerText = '✓ Cupón STREAMER100 aplicado: 100% GRATIS';
        feedback.classList.add('text-emerald-400');
      } else if (code === 'LAUNCH20') {
        currentDiscountPercent = 20;
        feedback.innerText = '✓ Cupón LAUNCH20 aplicado: 20% de descuento';
        feedback.classList.add('text-emerald-400');
      } else {
        feedback.innerText = '✕ Cupón no válido o expirado';
        feedback.classList.add('text-red-400');
        currentDiscountPercent = 0;
      }
      recalculateTotals();
    }

    function applyDemoCoupon(code) {
      document.getElementById('coupon-input').value = code;
      applyCoupon();
    }

    function recalculateTotals() {
      const discountRow = document.getElementById('discount-row');
      const discountAmountEl = document.getElementById('discount-amount');
      const totalAmountEl = document.getElementById('total-amount');

      const discountValue = BASE_PRICE * (currentDiscountPercent / 100);
      const finalPrice = Math.max(0, BASE_PRICE - discountValue);

      if (currentDiscountPercent > 0) {
        discountRow.classList.remove('hidden');
        discountAmountEl.innerText = discountValue.toFixed(2);
      } else {
        discountRow.classList.add('hidden');
      }

      totalAmountEl.innerText = finalPrice.toFixed(2);
      document.querySelectorAll('.unit-price-display').forEach(el => el.innerText = finalPrice.toFixed(2));
      document.querySelectorAll('.installment-3-display').forEach(el => el.innerText = (finalPrice / 3).toFixed(2));
      document.querySelectorAll('.installment-6-display').forEach(el => el.innerText = (finalPrice / 6).toFixed(2));

      // Actualizar modal MP si está abierto
      const mpModalPrice = document.getElementById('mp-modal-price');
      const mpModalBtnPrice = document.getElementById('mp-modal-btn-price');
      if (mpModalPrice) mpModalPrice.innerText = finalPrice.toFixed(2);
      if (mpModalBtnPrice) mpModalBtnPrice.innerText = finalPrice.toFixed(2);
    }

    // ── Formato de Tarjetas Interactivas ────────────────────────────────────
    function onCardNumberInput(input) {
      let val = input.value.replace(/\D/g, '').substring(0, 16);
      let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
      input.value = formatted;

      const display = document.getElementById('card-number-display');
      display.innerText = formatted || '•••• •••• •••• 4242';

      // Detectar Marca
      const brandDisplay = document.getElementById('card-brand-display');
      if (val.startsWith('4')) brandDisplay.innerText = 'VISA';
      else if (val.startsWith('5')) brandDisplay.innerText = 'MASTERCARD';
      else if (val.startsWith('3')) brandDisplay.innerText = 'AMEX';
      else brandDisplay.innerText = 'CARD';
    }

    function onExpInput(input) {
      let val = input.value.replace(/\D/g, '').substring(0, 4);
      if (val.length >= 2) {
        val = val.substring(0, 2) + '/' + val.substring(2);
      }
      input.value = val;
      document.getElementById('card-exp-display').innerText = val || '12/28';
    }

    function fillTestCard(type) {
      const numInput = document.getElementById('cc-number');
      const nameInput = document.getElementById('cc-name');
      const expInput = document.getElementById('cc-exp');
      const cscInput = document.getElementById('cc-csc');

      switch (type) {
        case 'visa_ok':
          numInput.value = '4242 4242 4242 4242';
          expInput.value = '12/28';
          cscInput.value = '123';
          selectedOutcome = 'approved';
          break;
        case 'mc_ok':
          numInput.value = '5555 5555 5555 5555';
          expInput.value = '10/27';
          cscInput.value = '456';
          selectedOutcome = 'approved';
          break;
        case 'insufficient':
          numInput.value = '4012 8888 8888 1881';
          expInput.value = '08/26';
          cscInput.value = '789';
          selectedOutcome = 'rejected';
          break;
        case 'declined':
          numInput.value = '4111 1111 1111 1111';
          expInput.value = '05/25';
          cscInput.value = '000';
          selectedOutcome = 'rejected';
          break;
      }
      onCardNumberInput(numInput);
      onExpInput(expInput);
    }

    // ── Activación de Mercado Pago Checkout Pro ─────────────────────────────
    async function triggerMPCheckoutPro() {
      // 1. Si MP está configurado con credenciales reales en producción:
      if (IS_MP_CONFIGURED && MP_PUBLIC_KEY && typeof MercadoPago !== 'undefined') {
        try {
          const res = await fetch('/api/checkout/preference', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              overlayId: OVERLAY_ID,
              couponCode: document.getElementById('coupon-input').value
            })
          });
          const data = await res.json();
          if (data.ok && data.preferenceId) {
            if (data.isDemo) {
              // Abrir simulación interactiva
              openMPModal();
              return;
            }
            // Inicializar Checkout Pro oficial
            const mp = new MercadoPago(MP_PUBLIC_KEY, { locale: 'es-AR' });
            mp.checkout({
              preference: { id: data.preferenceId },
              autoOpen: true
            });
            return;
          }
        } catch (err) {
          console.warn('[Checkout Pro]', err);
        }
      }

      // 2. Si estamos en Modo Demostración (default):
      openMPModal();
    }

    // ── Control Modal Mercado Pago Simulator ────────────────────────────────
    function openMPModal() {
      recalculateTotals();
      document.getElementById('mp-modal-simulator').classList.remove('hidden');
    }

    function closeMPModal() {
      document.getElementById('mp-modal-simulator').classList.add('hidden');
    }

    function setModalOutcome(outcome) {
      selectedOutcome = outcome;
      ['approved', 'rejected', 'pending'].forEach(o => {
        const btn = document.getElementById(`btn-out-${o}`);
        if (o === outcome) {
          btn.className = `py-1 px-2 rounded-lg font-bold text-center border ${
            o === 'approved' ? 'border-emerald-500 bg-emerald-500/20 text-emerald-300' :
            o === 'rejected' ? 'border-red-500 bg-red-500/20 text-red-300' :
            'border-amber-500 bg-amber-500/20 text-amber-300'
          }`;
        } else {
          btn.className = 'py-1 px-2 rounded-lg font-bold text-center border border-white/10 bg-white/5 text-white/70 hover:text-white';
        }
      });
    }

    function confirmMPSimulatedPayment() {
      closeMPModal();
      simulatePaymentFlow('mercadopago_checkout_pro');
    }

    // ── Ejecución de la Simulación de Pago ──────────────────────────────────
    async function simulatePaymentFlow(method = 'mercadopago_checkout_pro') {
      const modal = document.getElementById('payment-result-modal');
      const processing = document.getElementById('processing-state');
      const success = document.getElementById('success-state');
      const rejected = document.getElementById('rejected-state');
      const pending = document.getElementById('pending-state');
      const stepText = document.getElementById('processing-step');

      // Reset vistas
      modal.classList.remove('hidden');
      processing.classList.remove('hidden');
      success.classList.add('hidden');
      rejected.classList.add('hidden');
      pending.classList.add('hidden');

      stepText.innerText = '1. Conectando de forma segura con Mercado Pago...';

      await new Promise(r => setTimeout(r, 600));
      stepText.innerText = '2. Verificando fondos y token de pago seguro...';

      await new Promise(r => setTimeout(r, 700));
      stepText.innerText = '3. Generando token criptográfico de descarga...';

      try {
        const res = await fetch('/api/checkout/simulate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            overlayId: OVERLAY_ID,
            outcome: selectedOutcome,
            paymentMethod: method,
            discount: currentDiscountPercent,
            buyerEmail: document.getElementById('buyer-email').value,
            buyerName: document.getElementById('buyer-name').value,
            cardLast4: document.getElementById('cc-number').value.replace(/\s/g, '').slice(-4) || '4242',
            installments: document.getElementById('cc-installments')?.value || 1
          })
        });

        const data = await res.json();
        processing.classList.add('hidden');

        if (data.ok && data.status === 'approved') {
          // Éxito
          success.classList.remove('hidden');
          document.getElementById('receipt-id').innerText = data.mpPaymentId || 'MP-SIM-9482019';
          document.getElementById('receipt-amount').innerText = data.overlay?.price || '499.00';
          document.getElementById('receipt-method').innerText =
            method === 'transfer' ? 'Transferencia Bancaria / CVU' :
            method === 'card' ? 'Tarjeta Débito / Crédito' : 'Mercado Pago Checkout Pro';

          // Asignar token al botón de descarga
          const downloadBtn = document.getElementById('btn-download-token');
          if (data.downloadToken) {
            downloadBtn.href = `/download/${data.downloadToken}`;
          }

          // Tirar confetti
          if (typeof confetti === 'function') {
            confetti({
              particleCount: 80,
              spread: 70,
              origin: { y: 0.6 }
            });
          }
        } else if (data.status === 'pending') {
          // Pendiente
          pending.classList.remove('hidden');
          if (data.barcode) document.getElementById('pending-code').innerText = data.barcode;
        } else {
          // Rechazado
          rejected.classList.remove('hidden');
          if (data.reason) document.getElementById('rejection-reason').innerText = data.reason;
        }

      } catch (err) {
        console.error(err);
        processing.classList.add('hidden');
        rejected.classList.remove('hidden');
        document.getElementById('rejection-reason').innerText = 'Error de conexión con el servidor al procesar el pago.';
      }
    }

    function submitCardPayment(e) {
      e.preventDefault();
      simulatePaymentFlow('card');
    }

    function quickSimulate(outcome) {
      selectedOutcome = outcome;
      simulatePaymentFlow('mercadopago_checkout_pro');
    }

    function closePaymentResultModal() {
      document.getElementById('payment-result-modal').classList.add('hidden');
    }

    // ── Guía Modal Mercado Pago ─────────────────────────────────────────────
    function openMPGuideModal() {
      document.getElementById('mp-guide-modal').classList.remove('hidden');
    }
    function closeMPGuideModal() {
      document.getElementById('mp-guide-modal').classList.add('hidden');
    }

    function openOBSInstructions() {
      alert("Instrucciones para OBS Studio:\n\n1. Descarga el paquete .ZIP y descomprímelo.\n2. Abre OBS Studio y ve al panel 'Colección de escenas' -> 'Importar'.\n3. Selecciona el archivo scene_collection.json o agrega las fuentes BrowserSource con index.html.");
    }

    function copyToClipboard(text, btn) {
      navigator.clipboard.writeText(text);
      const original = btn.innerHTML;
      btn.innerHTML = `<span class="material-symbols-outlined text-[14px] text-emerald-400">check</span> Copiado`;
      setTimeout(() => { btn.innerHTML = original; }, 2000);
    }
  </script>
</body>
</html>
