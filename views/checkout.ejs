<!DOCTYPE html>
<html lang="es" class="dark">
<%- include('partials/head') %>

<body class="bg-[#0D0D14] text-[#e4e1ec] min-h-screen flex flex-col font-['Inter',sans-serif]">
  <%- include('partials/navbar') %>

  <!-- SDK oficial de Mercado Pago V2 -->
  <script src="https://sdk.mercadopago.com/js/v2"></script>
  <!-- Confetti para animación de éxito -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">

    <!-- ── Breadcrumbs & Modo Demo Bar ──────────────────────────────────────── -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <nav class="flex items-center gap-2 text-xs text-on-surface-variant mb-2">
          <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">storefront</span> Marketplace
          </a>
          <span>/</span>
          <a href="/overlay/<%= overlay.slug || overlay.id %>" class="hover:text-primary transition-colors">
            <%= overlay.name %>
          </a>
          <span>/</span>
          <span class="text-white font-medium">Checkout Seguro</span>
        </nav>
        <h1 class="text-2xl md:text-3xl font-extrabold text-white flex items-center gap-3">
          Finalizar Compra
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Checkout Seguro SSL 256-Bit
          </span>
        </h1>
      </div>

      <!-- Developer / Demo Switcher Banner -->
      <div class="flex flex-wrap items-center gap-2 bg-[#1A1A24] border border-white/10 rounded-2xl p-2.5 shadow-xl">
        <div class="flex items-center gap-2 px-2 text-xs font-semibold text-secondary">
          <span class="material-symbols-outlined text-[18px]">verified_user</span>
          <span>Modo Demo MP</span>
        </div>
        <div class="h-4 w-px bg-white/10"></div>
        <button type="button" onclick="openMPGuideModal()" class="px-3 py-1 rounded-lg text-xs font-medium text-white/80 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center gap-1">
          <span class="material-symbols-outlined text-[14px]">settings</span>
          <span>Configurar MP Pro</span>
        </button>
        <div class="h-4 w-px bg-white/10"></div>
        <!-- Quick Simulators -->
        <span class="text-[11px] text-white/50 hidden sm:inline">Simular:</span>
        <button type="button" onclick="quickSimulate('approved')" class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-emerald-300 bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 transition-all">
          ✓ Éxito
        </button>
        <button type="button" onclick="quickSimulate('rejected')" class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-red-300 bg-red-500/15 hover:bg-red-500/25 border border-red-500/30 transition-all">
          ✕ Rechazo
        </button>
        <button type="button" onclick="quickSimulate('pending')" class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-amber-300 bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/30 transition-all">
          ⏳ Pendiente
        </button>
      </div>
    </div>

    <% if (alreadyPurchased) { %>
    <!-- Banner de aviso si ya fue adquirido -->
    <div class="mb-8 p-4 rounded-2xl border border-secondary/30 bg-secondary/10 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-secondary text-2xl">check_circle</span>
        <div>
          <p class="font-bold text-white text-sm">¡Ya posees este overlay en tu biblioteca!</p>
          <p class="text-xs text-on-surface-variant">Puedes descargarlo inmediatamente o simular otra compra para demostración.</p>
        </div>
      </div>
      <a href="/download/<%= purchaseData.download_token %>" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-secondary-container to-secondary hover:opacity-90 transition-all shrink-0">
        Descargar Ahora
      </a>
    </div>
    <% } %>

    <!-- ── GRID PRINCIPAL: Pasarela (Izq) vs Resumen (Der) ──────────────────── -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- COLUMNA IZQUIERDA: Formulario y Pasarela (7 cols) -->
      <div class="lg:col-span-7 space-y-6">

        <!-- 1. Datos del Comprador -->
        <section class="rounded-2xl border border-white/10 bg-[#15151e]/80 backdrop-blur-xl p-6 shadow-2xl">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-primary/20 text-primary text-xs flex items-center justify-center font-bold">1</span>
              Datos del Comprador
            </h2>
            <% if (user) { %>
              <span class="text-xs text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20 flex items-center gap-1">
                <span class="material-symbols-outlined text-[13px]">verified</span> Conectado como @<%= user.username %>
              </span>
            <% } else { %>
              <span class="text-xs text-on-surface-variant">
                ¿Tienes cuenta? <a href="/login?returnTo=/checkout/<%= overlay.id %>" class="text-primary hover:underline font-semibold">Iniciar sesión</a>
              </span>
            <% } %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="buyer-name" class="block text-xs font-medium text-on-surface-variant mb-1">Nombre Completo</label>
              <input type="text" id="buyer-name" name="buyer-name" autocomplete="name" required
                     value="<%= user ? (user.display_name || user.username) : 'Alex Streamer' %>"
                     class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder-white/30"
                     placeholder="Ej: Franco Calegari" />
            </div>

            <div>
              <label for="buyer-email" class="block text-xs font-medium text-on-surface-variant mb-1">Correo Electrónico (Para recibir enlace)</label>
              <input type="email" id="buyer-email" name="buyer-email" autocomplete="email" required
                     value="<%= user ? user.email : 'alex@twitch.tv' %>"
                     class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder-white/30"
                     placeholder="tu@email.com" />
            </div>

            <div class="sm:col-span-2">
              <label for="buyer-dni" class="block text-xs font-medium text-on-surface-variant mb-1">DNI / Identificación Fiscal (Opcional - Factura)</label>
              <input type="text" id="buyer-dni" name="buyer-dni" inputmode="numeric"
                     value="38492019"
                     class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder-white/30"
                     placeholder="Número de DNI para Mercado Pago" />
            </div>
          </div>
        </section>

        <!-- 2. Método de Pago Selector -->
        <section class="rounded-2xl border border-white/10 bg-[#15151e]/80 backdrop-blur-xl p-6 shadow-2xl">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-primary/20 text-primary text-xs flex items-center justify-center font-bold">2</span>
              Medio de Pago
            </h2>
            <div class="flex items-center gap-1.5 text-xs text-[#009ee3] font-semibold">
              <img src="https://http2.mlstatic.com/frontend-assets/ui-navigation/5.18.9/mercadopago/favicon.ico" class="w-4 h-4 rounded-full" alt="MP" />
              <span>Checkout Pro</span>
            </div>
          </div>

          <!-- Selector de Pestañas / Métodos -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6">
            <!-- Tab 1: MP Checkout Pro -->
            <button type="button" onclick="switchMethod('mp_pro')" id="tab-btn-mp_pro"
                    class="method-tab active flex flex-col items-center justify-center p-3 rounded-xl border text-center transition-all bg-[#009ee3]/10 border-[#009ee3] text-white">
              <span class="material-symbols-outlined text-[24px] text-[#009ee3] mb-1">wallet</span>
              <span class="text-xs font-bold leading-tight">Mercado Pago</span>
              <span class="text-[10px] text-white/50">Checkout Pro</span>
            </button>

            <!-- Tab 2: Tarjetas -->
            <button type="button" onclick="switchMethod('cards')" id="tab-btn-cards"
                    class="method-tab flex flex-col items-center justify-center p-3 rounded-xl border text-center transition-all bg-white/[0.03] border-white/10 text-on-surface-variant hover:text-white hover:border-white/20">
              <span class="material-symbols-outlined text-[24px] mb-1">credit_card</span>
              <span class="text-xs font-bold leading-tight">Tarjetas</span>
              <span class="text-[10px] text-white/50">Crédito / Débito</span>
            </button>

            <!-- Tab 3: Transferencia / DEBIN -->
            <button type="button" onclick="switchMethod('transfer')" id="tab-btn-transfer"
                    class="method-tab flex flex-col items-center justify-center p-3 rounded-xl border text-center transition-all bg-white/[0.03] border-white/10 text-on-surface-variant hover:text-white hover:border-white/20">
              <span class="material-symbols-outlined text-[24px] mb-1">qr_code_2</span>
              <span class="text-xs font-bold leading-tight">Transferencia</span>
              <span class="text-[10px] text-white/50">CVU / DEBIN</span>
            </button>

            <!-- Tab 4: Efectivo -->
            <button type="button" onclick="switchMethod('cash')" id="tab-btn-cash"
                    class="method-tab flex flex-col items-center justify-center p-3 rounded-xl border text-center transition-all bg-white/[0.03] border-white/10 text-on-surface-variant hover:text-white hover:border-white/20">
              <span class="material-symbols-outlined text-[24px] mb-1">receipt_long</span>
              <span class="text-xs font-bold leading-tight">Efectivo</span>
              <span class="text-[10px] text-white/50">Rapipago/PagoFácil</span>
            </button>
          </div>

          <!-- CONTENIDO TAB 1: Mercado Pago Checkout Pro (Oficial & Simulador) -->
          <div id="content-mp_pro" class="method-content space-y-4">
            <div class="rounded-2xl p-5 border border-[#009ee3]/30 bg-gradient-to-br from-[#009ee3]/10 via-[#151522] to-[#12121c] relative overflow-hidden">
              <div class="absolute -right-8 -bottom-8 w-40 h-40 bg-[#009ee3]/15 rounded-full blur-3xl pointer-events-none"></div>

              <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#009ee3]/20 border border-[#009ee3]/40 text-[#009ee3] text-[11px] font-bold uppercase tracking-wider mb-2">
                    <span class="material-symbols-outlined text-[13px]">bolt</span> Recomendado Mercado Pago
                  </div>
                  <h3 class="text-lg font-bold text-white">Mercado Pago Checkout Pro</h3>
                  <p class="text-xs text-on-surface-variant mt-1 leading-relaxed">
                    Paga con dinero disponible en cuenta, tarjetas bancarias de débito y crédito en cuotas fijas, o con Mercado Crédito.
                  </p>
                </div>
                <img src="https://http2.mlstatic.com/frontend-assets/ui-navigation/5.18.9/mercadopago/logo__small.png" alt="Mercado Pago" class="h-8 object-contain shrink-0" />
              </div>

              <!-- Medios Aceptados Badges -->
              <div class="flex flex-wrap items-center gap-2 mb-5">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white/5 text-white/80 border border-white/10">Dinero en MP</span>
                <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white/5 text-white/80 border border-white/10">Visa / Mastercard / Cabal</span>
                <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white/5 text-white/80 border border-white/10">Mercado Crédito</span>
                <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white/5 text-white/80 border border-white/10">Rapipago / Pago Fácil</span>
              </div>

              <!-- Contenedor Oficial Wallet Brick de Mercado Pago (para cuando hay credenciales activas) -->
              <div id="wallet_container" class="mb-3"></div>

              <!-- Botón Checkout Pro (Funciona en Demo o abre la simulación interactiva) -->
              <button type="button" id="btn-mp-checkout-pro" onclick="triggerMPCheckoutPro()"
                      class="w-full py-4 px-6 rounded-xl font-bold text-white text-base shadow-xl flex items-center justify-center gap-3 transition-all hover:scale-[1.01] hover:brightness-110 active:scale-[0.99]"
                      style="background: linear-gradient(135deg, #009ee3 0%, #007bb5 100%); box-shadow: 0 8px 25px rgba(0, 158, 227, 0.35);">
                <img src="https://http2.mlstatic.com/frontend-assets/ui-navigation/5.18.9/mercadopago/favicon.ico" class="w-5 h-5 rounded-full" alt="MP Icon" />
                <span>Pagar con Mercado Pago Checkout Pro</span>
                <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
              </button>

              <div class="mt-3 flex items-center justify-center gap-4 text-[11px] text-white/50">
                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px] text-emerald-400">lock</span> Pago Seguro</span>
                <span>•</span>
                <span>Sin costos ocultos</span>
                <span>•</span>
                <span>Descarga instantánea</span>
              </div>
            </div>
          </div>

          <!-- CONTENIDO TAB 2: Tarjetas de Crédito / Débito con Simulador 3D -->
          <div id="content-cards" class="method-content hidden space-y-6">

            <!-- 3D Card Interactive Preview -->
            <div class="relative w-full max-w-sm mx-auto h-48 rounded-2xl p-6 text-white shadow-2xl transition-all duration-500 overflow-hidden border border-white/15"
                 id="virtual-card"
                 style="background: linear-gradient(135deg, #1f1b3c 0%, #151128 50%, #0c2340 100%); box-shadow: 0 15px 35px rgba(0,0,0,0.5), inset 0 0 20px rgba(124,58,237,0.2);">
              <!-- Holographic effect glow -->
              <div class="absolute -top-12 -left-12 w-32 h-32 bg-primary/30 rounded-full blur-2xl pointer-events-none"></div>
              <div class="absolute -bottom-12 -right-12 w-32 h-32 bg-secondary/20 rounded-full blur-2xl pointer-events-none"></div>

              <div class="flex items-center justify-between mb-4 relative z-10">
                <div class="w-10 h-7 rounded-md bg-amber-400/80 border border-amber-300 flex items-center justify-center">
                  <div class="w-6 h-4 border border-amber-600/40 rounded-sm"></div>
                </div>
                <span id="card-brand-display" class="font-extrabold italic text-sm tracking-widest text-white/90">VISA</span>
              </div>

              <!-- Card Number -->
              <div class="mt-2 mb-4 relative z-10">
                <p id="card-number-display" class="font-mono text-lg tracking-wider text-white drop-shadow">
                  •••• •••• •••• 4242
                </p>
              </div>

              <!-- Footer info: Holder & Expiry -->
              <div class="flex items-end justify-between relative z-10 text-xs">
                <div>
                  <p class="text-[9px] uppercase tracking-wider text-white/50">Titular</p>
                  <p id="card-name-display" class="font-semibold uppercase tracking-wide truncate max-w-[180px]">
                    <%= user ? (user.display_name || user.username) : 'ALEX STREAMER' %>
                  </p>
                </div>
                <div class="text-right">
                  <p class="text-[9px] uppercase tracking-wider text-white/50">Vence</p>
                  <p id="card-exp-display" class="font-mono font-semibold">12/28</p>
                </div>
              </div>
            </div>

            <!-- Chips de Prueba Rápida -->
            <div>
              <p class="text-xs text-on-surface-variant font-medium mb-2">Tarjetas de Prueba (Haz click para autocompletar):</p>
              <div class="flex flex-wrap gap-2">
                <button type="button" onclick="fillTestCard('visa_ok')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white/5 hover:bg-white/10 text-emerald-400 border border-emerald-500/30 transition-all flex items-center gap-1">
                  <span>💳 Visa Aprobada (4242)</span>
                </button>
                <button type="button" onclick="fillTestCard('mc_ok')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white/5 hover:bg-white/10 text-emerald-400 border border-emerald-500/30 transition-all flex items-center gap-1">
                  <span>💳 Mastercard (5555)</span>
                </button>
                <button type="button" onclick="fillTestCard('insufficient')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white/5 hover:bg-white/10 text-amber-400 border border-amber-500/30 transition-all flex items-center gap-1">
                  <span>⚠️ Fondos Insuf. (4012)</span>
                </button>
                <button type="button" onclick="fillTestCard('declined')" class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-white/5 hover:bg-white/10 text-red-400 border border-red-500/30 transition-all flex items-center gap-1">
                  <span>✕ Rechazada (4111)</span>
                </button>
              </div>
            </div>

            <!-- Card Form Fields siguiendo Modern Web Guidance -->
            <form id="card-form" onsubmit="submitCardPayment(event)" class="space-y-4">
              <div>
                <label for="cc-number" class="block text-xs font-medium text-on-surface-variant mb-1">Número de Tarjeta</label>
                <div class="relative">
                  <input id="cc-number" name="cc-number" type="text" autocomplete="cc-number"
                         inputmode="numeric" maxlength="19" pattern="[\d ]{13,19}" required
                         value="4242 4242 4242 4242"
                         oninput="onCardNumberInput(this)"
                         class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white font-mono tracking-wider focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder-white/30"
                         placeholder="1234 5678 9012 3456" />
                  <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-white/40 text-[20px]">credit_card</span>
                </div>
              </div>

              <div>
                <label for="cc-name" class="block text-xs font-medium text-on-surface-variant mb-1">Nombre en la Tarjeta</label>
                <input id="cc-name" name="cc-name" type="text" autocomplete="cc-name"
                       maxlength="50" pattern="[\p{L} \-\.]+" required
                       value="<%= user ? (user.display_name || user.username) : 'Alex Streamer' %>"
                       oninput="document.getElementById('card-name-display').innerText = this.value.toUpperCase() || 'TITULAR'"
                       class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white uppercase focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder-white/30"
                       placeholder="COMO APARECE EN LA TARJETA" />
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="cc-exp" class="text-xs font-medium text-on-surface-variant">Vencimiento</label>
                    <span id="exp-hint" class="text-[10px] text-white/40">MM/AA</span>
                  </div>
                  <input id="cc-exp" name="cc-exp" type="text" autocomplete="cc-exp"
                         aria-describedby="exp-hint" maxlength="5" required
                         value="12/28"
                         oninput="onExpInput(this)"
                         class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white font-mono text-center focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder-white/30"
                         placeholder="MM/AA" />
                </div>

                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="cc-csc" class="text-xs font-medium text-on-surface-variant">Código Seguridad</label>
                    <span class="text-[10px] text-white/40">3 o 4 dígitos</span>
                  </div>
                  <input id="cc-csc" name="cc-csc" type="text" autocomplete="cc-csc"
                         inputmode="numeric" maxlength="4" pattern="[0-9]{3,4}" required
                         value="123"
                         class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white font-mono text-center focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all placeholder-white/30"
                         placeholder="CVV / CVC" />
                </div>
              </div>

              <!-- Cuotas -->
              <div>
                <label for="cc-installments" class="block text-xs font-medium text-on-surface-variant mb-1">Plan de Cuotas</label>
                <select id="cc-installments" name="cc-installments"
                        class="w-full bg-[#1b1b26] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all">
                  <option value="1">1 cuota de $<span class="unit-price-display"><%= parseFloat(overlay.price).toFixed(2) %></span> (Sin recargo)</option>
                  <option value="3">3 cuotas fijas de $<span class="installment-3-display"><%= (parseFloat(overlay.price) / 3).toFixed(2) %></span></option>
                  <option value="6">6 cuotas fijas de $<span class="installment-6-display"><%= (parseFloat(overlay.price) / 6).toFixed(2) %></span></option>
                </select>
              </div>

              <button type="submit" id="btn-submit-card"
                      class="w-full py-4 px-6 rounded-xl font-bold text-white text-base shadow-xl flex items-center justify-center gap-2 transition-all hover:scale-[1.01] hover:brightness-110 active:scale-[0.99] primary-gradient">
                <span class="material-symbols-outlined text-[20px]">lock</span>
                <span>Pagar $<span class="unit-price-display"><%= parseFloat(overlay.price).toFixed(2) %></span> <%= overlay.currency || 'ARS' %></span>
              </button>
            </form>
          </div>

          <!-- CONTENIDO TAB 3: Transferencia DEBIN / CVU -->
          <div id="content-transfer" class="method-content hidden space-y-4">
            <div class="rounded-2xl p-6 border border-white/10 bg-[#1A1A24] text-center">
              <div class="w-48 h-48 mx-auto bg-white p-3 rounded-2xl shadow-xl flex items-center justify-center mb-4 relative">
                <!-- QR Code visual simulado con logo de Mercado Pago al centro -->
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=mercadopago://transfer?alias=SIMPLYOVER.MP&amount=<%= overlay.price %>"
                     alt="QR Transferencia" class="w-full h-full object-contain" />
              </div>

              <p class="text-xs text-on-surface-variant mb-3">Escanea desde tu app bancaria o Mercado Pago con cualquier billetera virtual</p>

              <div class="space-y-2 max-w-sm mx-auto text-left">
                <div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/10">
                  <div>
                    <p class="text-[10px] text-white/50 uppercase">Alias Mercado Pago</p>
                    <p class="font-mono text-sm font-bold text-secondary">SIMPLYOVER.MP</p>
                  </div>
