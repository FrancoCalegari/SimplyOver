<!DOCTYPE html>
<html class="dark" lang="en">
<%- include('partials/head', {title: title || 'My Boards | SimplyOver'}) %>
<body class="overflow-x-hidden bg-background text-on-background">
  <%- include('partials/navbar') %>
  <div class="flex min-h-[calc(100vh-80px)]">
    <%- include('partials/dashboard_sidebar', {activeTab: 'boards'}) %>

    <main class="flex-1 md:ml-[280px] px-5 md:px-10 py-10">

      <!-- Header -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-5">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-white">My Boards</h1>
          <p class="text-on-surface-variant mt-1">
            <%= typeof boards !== 'undefined' ? boards.length : 0 %> boards
          </p>
        </div>
        <div class="flex items-center gap-3">
          <!-- Filtro por tag -->
          <% if (typeof allTags !== 'undefined' && allTags.length > 0) { %>
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs text-on-surface-variant font-semibold uppercase">Filter:</span>
            <a href="/boards" class="tag-badge <%= !filters || !filters.tag ? 'active' : '' %>">All</a>
            <% allTags.forEach(function(tag) { %>
              <a href="/boards?tag=<%= encodeURIComponent(tag) %>" class="tag-badge <%= filters && filters.tag === tag ? 'active' : '' %>"><%= tag %></a>
            <% }); %>
          </div>
          <% } %>
          <button onclick="document.getElementById('create-modal').classList.remove('hidden')"
                  class="flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-white hover:scale-105 transition-transform shrink-0"
                  style="background: linear-gradient(45deg,#7c3aed,#ddb7ff)">
            <span class="material-symbols-outlined">add</span> New Board
          </button>
        </div>
      </div>

      <!-- Search -->
      <form method="GET" action="/boards" class="mb-8">
        <div class="glass-level-1 flex items-center px-4 py-2.5 rounded-full border border-white/5 max-w-sm">
          <span class="material-symbols-outlined text-secondary mr-2 text-[18px]">search</span>
          <input name="q" value="<%= typeof filters !== 'undefined' && filters.q ? filters.q : '' %>"
                 class="bg-transparent border-none focus:ring-0 text-sm font-medium w-full placeholder:text-on-surface-variant/50 text-white outline-none"
                 placeholder="Search boards..."/>
        </div>
      </form>

      <!-- Boards Grid -->
      <% if (typeof boards === 'undefined' || boards.length === 0) { %>
      <div class="flex flex-col items-center justify-center py-24 border-2 border-dashed border-white/5 rounded-3xl">
        <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mb-6">
          <span class="material-symbols-outlined text-on-surface-variant text-5xl">dashboard</span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-2">No boards yet</h2>
        <p class="text-on-surface-variant mb-6">Create a board to organize and save your favorite overlays.</p>
        <button onclick="document.getElementById('create-modal').classList.remove('hidden')"
                class="px-8 py-3 rounded-full font-bold text-white hover:scale-[1.02] transition-all"
                style="background: linear-gradient(45deg,#7c3aed,#ddb7ff)">
          Create your first board
        </button>
      </div>
      <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <% boards.forEach(function(board) { %>
        <div class="glass-surface glass-surface-hover rounded-xl overflow-hidden border border-white/10 hover:border-primary/30 transition-all duration-300 relative group cursor-pointer flex flex-col"
             id="board-card-<%= board.id %>">
          <!-- Preview images grid -->
          <div class="grid grid-cols-2 gap-1 h-44 overflow-hidden rounded-t-xl">
            <% if (board.preview_images && board.preview_images.length > 0) {
              for (let pi = 0; pi < 4; pi++) {
                const imgUrl = board.preview_images[pi];
            %>
              <% if (imgUrl) { %>
                <img class="w-full h-full object-cover" src="<%= imgUrl %>" alt="Board preview"/>
              <% } else { %>
                <div class="bg-surface-container flex items-center justify-center">
                  <span class="material-symbols-outlined text-3xl opacity-10">image</span>
                </div>
              <% }
              }
            } else {
              for (let pi = 0; pi < 4; pi++) { %>
                <div class="bg-surface-container flex items-center justify-center">
                  <span class="material-symbols-outlined text-3xl opacity-10">image</span>
                </div>
            <% } } %>
          </div>

          <!-- Info -->
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-xl font-bold text-white leading-tight"><%= board.name %></h3>
              <span class="shrink-0 ml-2 px-2.5 py-1 rounded-full text-xs flex items-center gap-1
                <%= board.visibility === 'public' ? 'bg-secondary-container/20 text-secondary border border-secondary/30' : 'bg-surface-variant text-on-surface-variant' %>">
                <span class="material-symbols-outlined text-sm"><%= board.visibility === 'public' ? 'public' : 'lock' %></span>
                <%= board.visibility === 'public' ? 'Public' : 'Private' %>
              </span>
            </div>
            <p class="text-on-surface-variant text-sm mb-3"><%= board.item_count || 0 %> overlay<%= (board.item_count || 0) !== 1 ? 's' : '' %></p>

            <!-- Tags -->
            <% if (board.tags && board.tags.length > 0) { %>
            <div class="flex flex-wrap gap-1.5 mb-3">
              <% board.tags.forEach(function(tag) { %>
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/20 font-medium">#<%= tag %></span>
              <% }); %>
            </div>
            <% } %>
          </div>

          <!-- Hover Actions -->
          <div class="absolute inset-0 bg-background/80 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
            <button onclick="event.stopPropagation(); openEditBoard(this)"
                    data-board-id="<%= board.id %>"
                    data-board-name="<%= board.name %>"
                    data-board-desc="<%= board.description || '' %>"
                    data-board-visibility="<%= board.visibility %>"
                    data-board-tags="<%= (board.tags||[]).join(',') %>"
                    class="bg-surface-container-high p-3 rounded-full hover:bg-primary/20 transition-colors" title="Edit">
              <span class="material-symbols-outlined text-primary">edit</span>
            </button>
            <a href="/boards/<%= board.id %>"
               class="px-5 py-2.5 rounded-lg font-semibold text-white text-sm"
               style="background: linear-gradient(45deg,#7c3aed,#ddb7ff)">View Board</a>
            <button onclick="event.stopPropagation(); deleteBoard('<%= board.id %>')"
                    class="bg-surface-container-high p-3 rounded-full hover:bg-red-500/20 transition-colors" title="Delete">
              <span class="material-symbols-outlined text-red-400">delete</span>
            </button>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </main>
  </div>

  <!-- ═══ Modal: Create Board ═══ -->
  <div class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4" id="create-modal">
    <div class="absolute inset-0 bg-background/80 backdrop-blur-md" onclick="document.getElementById('create-modal').classList.add('hidden')"></div>
    <div class="glass-surface p-8 rounded-2xl w-full max-w-lg relative shadow-2xl border border-white/10 z-10">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">add_circle</span>
        Create New Board
      </h2>
      <div class="space-y-5">
        <div>
          <label class="block text-xs font-semibold text-primary uppercase tracking-wider mb-2">Board Name *</label>
          <input id="new-board-name" class="w-full bg-surface-container/60 border border-primary/20 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-primary/50 focus:border-primary/50 outline-none transition-all" placeholder="e.g. Cyberpunk Collection"/>
        </div>
        <div>
          <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-2">Description</label>
          <textarea id="new-board-desc" class="w-full bg-surface-container/60 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-primary/50 outline-none transition-all resize-none" placeholder="What's this board about?" rows="3"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-2">Tags <span class="font-normal">(comma separated)</span></label>
          <input id="new-board-tags" class="w-full bg-surface-container/60 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-primary/50 outline-none transition-all" placeholder="cyberpunk, neon, gaming"/>
        </div>
        <div class="flex items-center justify-between py-1">
          <div>
            <p class="font-semibold text-white text-sm">Make Public</p>
            <p class="text-xs text-on-surface-variant">Allow others to see and follow this board</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="new-board-public" checked class="sr-only peer"/>
            <div class="w-11 h-6 bg-surface-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
          </label>
        </div>
        <div class="flex gap-3 pt-2">
          <button onclick="document.getElementById('create-modal').classList.add('hidden')"
                  class="flex-1 bg-white/5 hover:bg-white/10 text-white font-semibold py-3 rounded-xl transition-colors text-sm">Cancel</button>
          <button onclick="createBoard()"
                  class="flex-1 font-bold py-3 rounded-xl text-white transition-all hover:scale-[1.02]"
                  style="background: linear-gradient(45deg,#7c3aed,#ddb7ff)">Create Board</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Modal: Edit Board ═══ -->
  <div class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4" id="edit-modal">
    <div class="absolute inset-0 bg-background/80 backdrop-blur-md" onclick="document.getElementById('edit-modal').classList.add('hidden')"></div>
    <div class="glass-surface p-8 rounded-2xl w-full max-w-lg relative shadow-2xl border border-white/10 z-10">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">edit</span>
        Edit Board
      </h2>
      <input type="hidden" id="edit-board-id"/>
      <div class="space-y-5">
        <div>
          <label class="block text-xs font-semibold text-primary uppercase tracking-wider mb-2">Board Name *</label>
          <input id="edit-board-name" class="w-full bg-surface-container/60 border border-primary/20 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-primary/50 outline-none transition-all"/>
        </div>
        <div>
          <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-2">Description</label>
          <textarea id="edit-board-desc" class="w-full bg-surface-container/60 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-primary/50 outline-none transition-all resize-none" rows="3"></textarea>
        </div>
        <div>
          <label class="block text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-2">Tags</label>
          <input id="edit-board-tags" class="w-full bg-surface-container/60 border border-white/10 rounded-xl px-4 py-3 text-white focus:ring-2 focus:ring-primary/50 outline-none transition-all"/>
        </div>
        <div class="flex items-center justify-between py-1">
          <div>
            <p class="font-semibold text-white text-sm">Make Public</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="edit-board-public" class="sr-only peer"/>
            <div class="w-11 h-6 bg-surface-variant peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
          </label>
        </div>
        <div class="flex gap-3 pt-2">
          <button onclick="document.getElementById('edit-modal').classList.add('hidden')"
                  class="flex-1 bg-white/5 hover:bg-white/10 text-white font-semibold py-3 rounded-xl transition-colors text-sm">Cancel</button>
          <button onclick="saveEditBoard()"
                  class="flex-1 font-bold py-3 rounded-xl text-white transition-all"
                  style="background: linear-gradient(45deg,#7c3aed,#ddb7ff)">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

<style>
  .tag-badge { padding: 4px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; color: #ccc3d8; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); transition: all 0.2s; }
  .tag-badge.active, .tag-badge:hover { background: rgba(210,187,255,0.12); color: #d2bbff; border-color: rgba(210,187,255,0.2); }
</style>

<script>
  async function createBoard() {
    const name = document.getElementById('new-board-name').value.trim();
    if (!name) return alert('Board name is required.');
    const payload = {
      name,
      description: document.getElementById('new-board-desc').value.trim(),
      tags: document.getElementById('new-board-tags').value.trim(),
      visibility: document.getElementById('new-board-public').checked ? 'public' : 'private',
    };
    try {
      const r = await fetch('/boards', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (r.ok) { window.location.reload(); }
      else { alert('Failed to create board.'); }
    } catch(e) { alert('Network error.'); }
  }

  function openEditBoard(btn) {
    const d = btn.dataset;
    document.getElementById('edit-board-id').value       = d.boardId;
    document.getElementById('edit-board-name').value     = d.boardName;
    document.getElementById('edit-board-desc').value     = d.boardDesc;
    document.getElementById('edit-board-tags').value     = d.boardTags;
    document.getElementById('edit-board-public').checked = d.boardVisibility === 'public';
    document.getElementById('edit-modal').classList.remove('hidden');
  }

  async function saveEditBoard() {
    const id = document.getElementById('edit-board-id').value;
    const payload = {
      name: document.getElementById('edit-board-name').value.trim(),
      description: document.getElementById('edit-board-desc').value.trim(),
      tags: document.getElementById('edit-board-tags').value.trim(),
      visibility: document.getElementById('edit-board-public').checked ? 'public' : 'private',
    };
    if (!payload.name) return alert('Board name is required.');
    try {
      const r = await fetch(`/boards/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (r.ok) { window.location.reload(); }
      else { alert('Failed to update board.'); }
    } catch(e) { alert('Network error.'); }
  }

  async function deleteBoard(id) {
    if (!confirm('Delete this board? All saved overlays will be removed from it.')) return;
    try {
      const r = await fetch(`/boards/${id}`, { method: 'DELETE' });
      if (r.ok) {
        const card = document.getElementById(`board-card-${id}`);
        card.style.transition = 'all 0.3s ease';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95)';
        setTimeout(() => card.remove(), 300);
      } else { alert('Failed to delete board.'); }
    } catch(e) { alert('Network error.'); }
  }
</script>
</body>
</html>
