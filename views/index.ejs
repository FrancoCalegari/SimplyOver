<!DOCTYPE html>
<html class="dark" lang="en">
<%- include('partials/head', {title: title || 'SimplyOver'}) %>
<%
  // Safe defaults — prevent "X is not defined" if rendered without full data
  const _f  = (typeof filters     !== 'undefined') ? filters     : {};
  const _cs = (typeof categories  !== 'undefined') ? categories  : [];
  const _ov = (typeof overlays    !== 'undefined') ? overlays    : [];
  const _pg = (typeof pagination  !== 'undefined') ? pagination  : { page: 1, hasMore: false };
  const _sw = (typeof spiderwebUrl!== 'undefined') ? spiderwebUrl: (process.env.SPIDERWEBURL || '');
%>
<body class="bg-background text-on-background">
    <%- include('partials/navbar') %>
    <div class="flex">
        <!-- SideNavBar — Filtros Dinámicos -->
        <aside class="fixed left-0 h-full w-[280px] bg-surface-container/40 backdrop-blur-xl border-r border-white/10 flex flex-col py-8 sidebar-transition z-40 hidden md:flex" id="sidebar">
            <div class="px-6 mb-8">
                <h2 class="text-2xl font-bold text-primary">Filters</h2>
                <p class="text-on-surface-variant text-sm">Refine your search</p>
            </div>

            <nav class="flex-1 space-y-1 overflow-y-auto px-3">

                <!-- All Categories -->
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all
                    <%= !_f.category && !_f.price && (_f.sort === 'newest' || !_f.sort) ? 'border-l-4 border-primary bg-primary/10 text-primary' : 'text-on-surface-variant hover:bg-white/5' %>">
                    <span class="material-symbols-outlined text-[20px]">apps</span>
                    <span class="font-medium">All Overlays</span>
                </a>

                <!-- Separador Precio -->
                <p class="px-4 pt-4 pb-1 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/50">Price</p>

                <a href="/?price=free<%= _f.category ? '&category=' + _f.category : '' %>"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all
                   <%= _f.price === 'free' ? 'border-l-4 border-secondary bg-secondary/10 text-secondary' : 'text-on-surface-variant hover:bg-white/5' %>">
                    <span class="material-symbols-outlined text-[20px]">money_off</span>
                    <span class="font-medium">Free</span>
                </a>

                <a href="/?price=paid<%= _f.category ? '&category=' + _f.category : '' %>"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all
                   <%= _f.price === 'paid' ? 'border-l-4 border-tertiary bg-tertiary/10 text-tertiary' : 'text-on-surface-variant hover:bg-white/5' %>">
                    <span class="material-symbols-outlined text-[20px]">attach_money</span>
                    <span class="font-medium">Premium</span>
                </a>

                <!-- Separador Ordenamiento -->
                <p class="px-4 pt-4 pb-1 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/50">Sort By</p>

                <a href="/?sort=trending<%= _f.category ? '&category=' + _f.category : '' %><%= _f.price ? '&price=' + _f.price : '' %>"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all
                   <%= _f.sort === 'trending' ? 'border-l-4 border-primary bg-primary/10 text-primary' : 'text-on-surface-variant hover:bg-white/5' %>">
                    <span class="material-symbols-outlined text-[20px]">trending_up</span>
                    <span class="font-medium">Trending</span>
                </a>

                <a href="/?sort=popular<%= _f.category ? '&category=' + _f.category : '' %><%= _f.price ? '&price=' + _f.price : '' %>"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all
                   <%= _f.sort === 'popular' ? 'border-l-4 border-primary bg-primary/10 text-primary' : 'text-on-surface-variant hover:bg-white/5' %>">
                    <span class="material-symbols-outlined text-[20px]">local_fire_department</span>
                    <span class="font-medium">Most Popular</span>
                </a>

                <a href="/?sort=rating<%= _f.category ? '&category=' + _f.category : '' %><%= _f.price ? '&price=' + _f.price : '' %>"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all
                   <%= _f.sort === 'rating' ? 'border-l-4 border-primary bg-primary/10 text-primary' : 'text-on-surface-variant hover:bg-white/5' %>">
                    <span class="material-symbols-outlined text-[20px]">star</span>
                    <span class="font-medium">Top Rated</span>
                </a>

                <!-- Separador Categorías -->
                <p class="px-4 pt-4 pb-1 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant/50">Categories</p>

                <% _cs.forEach(function(cat) { %>
                <a href="/?category=<%= cat.slug %><%= _f.price ? '&price=' + _f.price : '' %>"
                   class="flex items-center gap-3 px-4 py-3 rounded-lg transition-all
                   <%= _f.category === cat.slug ? 'border-l-4 border-primary bg-primary/10 text-primary' : 'text-on-surface-variant hover:bg-white/5' %>">
                    <span class="material-symbols-outlined text-[20px]"><%= cat.icon || 'label' %></span>
                    <span class="font-medium"><%= cat.name %></span>
                </a>
                <% }); %>

                <% if (_cs.length === 0) { %>
                <a href="/category/all" class="flex items-center gap-3 px-4 py-3 rounded-lg text-on-surface-variant hover:bg-white/5 transition-all">
                    <span class="material-symbols-outlined text-[20px]">category</span>
                    <span class="font-medium">Browse All</span>
                </a>
                <% } %>
            </nav>

            <!-- Clear Filters -->
            <% if (_f.category || _f.price || (_f.sort && _f.sort !== 'newest')) { %>
            <div class="px-6 mt-4">
                <a href="/" class="w-full flex items-center justify-center gap-2 border border-white/10 text-on-surface-variant py-3 rounded-xl font-semibold hover:bg-white/5 hover:text-white transition-all text-sm">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                    Clear Filters
                </a>
            </div>
            <% } %>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 md:ml-[280px] px-5 md:px-12 pt-12 pb-24">
            <!-- Hero Section -->
            <section class="max-w-4xl mx-auto text-center mb-16 space-y-6">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-surface border-white/20 text-secondary mb-4">
                    <span class="material-symbols-outlined text-[18px]">verified</span>
                    <span class="text-xs font-semibold">Official Stream Marketplace</span>
                </div>
                <h1 class="text-5xl md:text-6xl font-bold text-gradient leading-tight">
                    Discover Stunning<br>Stream Overlays
                </h1>
                <p class="text-lg text-on-surface-variant max-w-2xl mx-auto">
                    The world's premier marketplace for high-performance OBS overlays and artistic stream assets.
                </p>

                <!-- Filtros activos como chips -->
                <% if (_f.category || _f.price) { %>
                <div class="flex flex-wrap justify-center gap-2 mt-4">
                    <% if (_f.category) {
                        const catObj = _cs.find(c => c.slug === _f.category);
                    %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/15 border border-primary/30 text-primary text-sm font-medium">
                        <span class="material-symbols-outlined text-[14px]">label</span>
                        <%= catObj ? catObj.name : _f.category %>
                        <a href="/?<%= _f.price ? 'price=' + _f.price : '' %>" class="ml-1 hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-[14px]">close</span>
                        </a>
                    </span>
                    <% } %>
                    <% if (_f.price) { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary/15 border border-secondary/30 text-secondary text-sm font-medium">
                        <span class="material-symbols-outlined text-[14px]"><%= _f.price === 'free' ? 'money_off' : 'attach_money' %></span>
                        <%= _f.price === 'free' ? 'Free only' : 'Premium only' %>
                        <a href="/?<%= _f.category ? 'category=' + _f.category : '' %>" class="ml-1 hover:text-white transition-colors">
                            <span class="material-symbols-outlined text-[14px]">close</span>
                        </a>
                    </span>
                    <% } %>
                </div>
                <% } %>
            </section>

            <!-- Grid de Overlays Dinámico -->
            <% if (_ov.length === 0) { %>
            <div class="flex flex-col items-center justify-center py-32 border-2 border-dashed border-white/5 rounded-3xl">
                <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-on-surface-variant text-5xl">search_off</span>
                </div>
                <h2 class="text-2xl font-bold text-white mb-2">No overlays found</h2>
                <p class="text-on-surface-variant mb-6">Try removing a filter or check back soon.</p>
                <a href="/" class="px-6 py-3 rounded-full bg-primary/10 border border-primary/30 text-primary font-semibold hover:bg-primary/20 transition-all">
                    Clear all filters
                </a>
            </div>
            <% } else { %>
            <div class="masonry-grid" id="overlays-grid">
                <% _ov.forEach(function(overlay, i) { %>
                <%
                    let previewUrl = 'https://via.placeholder.com/400x300/13131a/d2bbff?text=Overlay';
                    try {
                        const ids = JSON.parse(overlay.preview_storage_ids || '[]');
                        if (ids[0]) previewUrl = '/api/files/' + ids[0];
                    } catch(e) {}
                    const isPremium = parseFloat(overlay.price) > 0;
                    const priceLabel = isPremium ? '$' + parseFloat(overlay.price).toFixed(2) : 'FREE';
                    const priceClass = isPremium ? 'bg-primary-container text-white' : 'bg-secondary-container/20 text-secondary border border-secondary/30';
                    const heights = [240, 280, 320, 200, 300];
                    const h = heights[i % 5];
                %>
                <article class="masonry-item group cursor-pointer relative overflow-hidden rounded-xl glass-surface transition-all duration-300 hover:scale-[1.02]
                    <%= overlay.is_featured ? 'border-primary/30 shadow-[0_0_20px_rgba(124,58,237,0.15)]' : 'border-white/10' %>"
                         onclick="window.location.href='/overlay/<%= overlay.slug || overlay.id %>'">

                    <div class="relative overflow-hidden">
                        <img class="w-full object-cover rounded-t-xl transition-transform duration-500 group-hover:scale-105"
                             src="<%= previewUrl %>"
                             style="height: <%= h %>px;"
                             alt="<%= overlay.name %>"
                             onerror="this.src='https://via.placeholder.com/400x<%= h %>/1f1f26/d2bbff?text=Overlay'"/>

                        <!-- Featured badge -->
                        <% if (overlay.is_featured) { %>
                        <span class="absolute top-3 left-3 px-2 py-1 rounded-lg text-[10px] font-bold bg-primary text-background flex items-center gap-1">
                            <span class="material-symbols-outlined text-[12px]">star</span>FEATURED
                        </span>
                        <% } %>

                        <!-- Price badge -->
                        <span class="absolute top-3 right-3 px-2.5 py-1 rounded-lg text-xs font-bold <%= priceClass %>">
                            <%= priceLabel %>
                        </span>

                        <!-- Hover actions -->
                        <div class="absolute inset-0 bg-background/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
                            <button class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center hover:bg-primary/50 transition-colors"
                                    onclick="event.stopPropagation(); addToFavorite('<%= overlay.id %>', this)" title="Favorite">
                                <span class="material-symbols-outlined text-white text-[18px]">favorite</span>
                            </button>
                            <button class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center hover:bg-secondary/50 transition-colors"
                                    onclick="event.stopPropagation(); addToBoard('<%= overlay.id %>')" title="Save to Board">
                                <span class="material-symbols-outlined text-white text-[18px]">push_pin</span>
                            </button>
                            <a href="/overlay/<%= overlay.slug || overlay.id %>"
                               class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center hover:bg-primary transition-colors" title="View"
                               onclick="event.stopPropagation()">
                                <span class="material-symbols-outlined text-white text-[18px]">visibility</span>
                            </a>
                        </div>
                    </div>

                    <div class="p-4">
                        <h3 class="font-semibold text-white text-sm mb-2 truncate"><%= overlay.name %></h3>
                        <div class="flex items-center justify-between">
                            <a href="/artist/<%= overlay.creator_username %>"
                               class="flex items-center gap-1.5 hover:opacity-80 transition-opacity"
                               onclick="event.stopPropagation()">
                                <% if (overlay.creator_avatar) { %>
                                <img src="/api/files/<%= overlay.creator_avatar %>"
                                     class="w-6 h-6 rounded-full object-cover border border-white/10"
                                     onerror="this.style.display='none'"/>
                                <% } else { %>
                                <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary text-[12px]">person</span>
                                </div>
                                <% } %>
                                <span class="text-xs text-on-surface-variant"><%= overlay.creator_display_name || overlay.creator_username %></span>
                            </a>

                            <% if (overlay.avg_rating) { %>
                            <div class="flex items-center gap-1 text-tertiary">
                                <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 1">star</span>
                                <span class="text-xs font-semibold"><%= overlay.avg_rating %></span>
                                <% if (overlay.review_count) { %>
                                <span class="text-[10px] text-on-surface-variant">(<%= overlay.review_count %>)</span>
                                <% } %>
                            </div>
                            <% } %>
                        </div>

                        <!-- Tags del overlay -->
                        <%
                        try {
                            const tags = JSON.parse(overlay.tags || '[]');
                            if (tags && tags.length > 0) {
                        %>
                        <div class="flex flex-wrap gap-1 mt-2">
                            <% tags.slice(0, 3).forEach(function(tag) { %>
                            <span class="px-2 py-0.5 rounded-full text-[10px] bg-white/5 border border-white/10 text-on-surface-variant">
                                <%= tag %>
                            </span>
                            <% }); %>
                        </div>
                        <% } } catch(e) {} %>
                    </div>
                </article>
                <% }); %>
            </div>

            <!-- Paginación -->
            <% if (_pg.hasMore || _pg.page > 1) { %>
            <div class="flex justify-center gap-3 mt-16">
                <% if (_pg.page > 1) { %>
                <a href="?page=<%= _pg.page - 1 %>&category=<%= _f.category||'' %>&price=<%= _f.price||'' %>&sort=<%= _f.sort||'newest' %>"
                   class="px-6 py-3 rounded-full glass-surface border-white/10 text-on-surface-variant hover:text-white transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span> Previous
                </a>
                <% } %>
                <% if (_pg.hasMore) { %>
                <a href="?page=<%= _pg.page + 1 %>&category=<%= _f.category||'' %>&price=<%= _f.price||'' %>&sort=<%= _f.sort||'newest' %>"
                   class="px-6 py-3 rounded-full bg-primary text-background font-semibold hover:scale-[1.02] transition-all flex items-center gap-2">
                    Load More <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>
                <% } %>
            </div>
            <% } %>
            <% } %>
        </main>
    </div>

    <%- include('partials/board_selector') %>
    <%- include('partials/footer') %>

<style>
.masonry-grid { columns: 1; column-gap: 1.5rem; }
@media (min-width: 640px) { .masonry-grid { columns: 2; } }
@media (min-width: 1024px) { .masonry-grid { columns: 3; } }
@media (min-width: 1280px) { .masonry-grid { columns: 4; } }
.masonry-item { break-inside: avoid; margin-bottom: 1.5rem; display: block; }
</style>

<script>
    document.querySelectorAll('.masonry-item').forEach(item => {
        item.addEventListener('mouseenter', () => item.style.zIndex = '10');
        item.addEventListener('mouseleave', () => item.style.zIndex = '1');
    });

    function addToFavorite(overlayId, btn) {
        fetch('/api/favorites', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ overlayId })
        }).then(r => {
            if (r.status === 401) return window.location.href = '/login?returnTo=' + encodeURIComponent(window.location.pathname);
            if (r.ok) {
                const icon = btn.querySelector('.material-symbols-outlined');
                icon.style.fontVariationSettings = "'FILL' 1";
                icon.style.color = '#ef4444';
                btn.title = 'Favorited!';
            }
        }).catch(console.error);
    }

    function addToBoard(overlayId) {
        if (typeof openBoardSelector === 'function') {
            openBoardSelector(overlayId);
        } else {
            if (!document.cookie.includes('so_token')) return window.location.href = '/login';
            alert('Board selector unavailable.');
        }
    }
</script>
</body>
</html>
