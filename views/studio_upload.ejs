<!DOCTYPE html>
<html class="dark" lang="en">
<%- include('partials/head', {title: title || 'Publish Overlay | SimplyOver'}) %>
<body class="bg-background text-on-background min-h-screen flex flex-col">
    <%- include('partials/navbar') %>

    <main class="flex-1 max-w-5xl mx-auto w-full px-5 pt-24 pb-24">
        <!-- Header -->
        <div class="mb-10 text-center">
            <h1 class="text-3xl font-bold text-white mb-2">Publish Project</h1>
            <p class="text-on-surface-variant">Choose how you want to create and upload your overlay.</p>
        </div>

        <!-- Creation Options -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
            <a href="/studio/canvas" class="glass-panel p-6 rounded-2xl border border-white/10 hover:border-primary/50 transition-all group flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-primary text-2xl group-hover:scale-110 transition-transform">brush</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white mb-1 flex items-center gap-2">Web Editor <span class="px-2 py-0.5 rounded-md bg-secondary/20 text-secondary text-[10px] uppercase">Beta</span></h3>
                    <p class="text-sm text-on-surface-variant">Design your overlay directly in the browser using our advanced canvas tools.</p>
                </div>
            </a>
            <a href="/studio/ai" class="glass-panel p-6 rounded-2xl border border-white/10 hover:border-secondary/50 transition-all group flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-secondary/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-secondary text-2xl group-hover:scale-110 transition-transform">auto_awesome</span>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-white mb-1">Create with AI</h3>
                    <p class="text-sm text-on-surface-variant">Generate a professional overlay template automatically using SpiderIA.</p>
                </div>
            </a>
        </div>

        <div class="flex items-center gap-4 mb-8">
            <div class="h-px bg-white/10 flex-1"></div>
            <span class="text-xs font-bold text-on-surface-variant uppercase tracking-widest">Or Upload Manually</span>
            <div class="h-px bg-white/10 flex-1"></div>
        </div>

        <!-- Manual Upload Form -->
        <div class="glass-surface border border-white/10 rounded-2xl shadow-2xl p-6 md:p-10">
            <form action="/studio/publish" method="POST" enctype="multipart/form-data" class="space-y-8" id="uploadForm">
                
                <section>
                    <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">info</span>
                        Basic Information
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Overlay Name <span class="text-red-400">*</span></label>
                            <input type="text" name="name" required class="w-full bg-surface-container-high border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary transition-colors focus:outline-none" placeholder="e.g. Neon Stream Pack">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Price (USD) <span class="text-red-400">*</span></label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant">$</span>
                                <input type="number" step="0.01" min="0" name="price" value="0.00" required class="w-full bg-surface-container-high border border-white/10 rounded-xl pl-8 pr-4 py-3 text-white focus:border-primary transition-colors focus:outline-none">
                            </div>
                            <p class="text-[10px] text-on-surface-variant mt-1">Set 0.00 for free</p>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Category <span class="text-red-400">*</span></label>
                            <select name="category_ids" required class="w-full bg-surface-container-high border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary transition-colors focus:outline-none">
                                <option value="">Select Category</option>
                                <% if (typeof categories !== 'undefined') { %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat.id %>"><%= cat.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Tags</label>
                            <input type="text" name="tags" class="w-full bg-surface-container-high border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary transition-colors focus:outline-none" placeholder="gaming, neon, retro">
                            <p class="text-[10px] text-on-surface-variant mt-1">Comma separated</p>
                        </div>
                    </div>
                </section>

                <hr class="border-white/5">

                <section>
                    <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">description</span>
                        About the Overlay
                    </h2>
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Short Description</label>
                            <input type="text" name="short_description" class="w-full bg-surface-container-high border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary transition-colors focus:outline-none" placeholder="Brief summary for the card...">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Full Description</label>
                            <textarea name="description" rows="5" class="w-full bg-surface-container-high border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary transition-colors focus:outline-none resize-none" placeholder="Describe all features and what's included..."></textarea>
                        </div>
                    </div>
                </section>

                <hr class="border-white/5">

                <section>
                    <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">settings_applications</span>
                        Technical Info
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Resolution</label>
                            <input type="text" name="resolution" value="1920x1080" class="w-full bg-surface-container-high border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary transition-colors focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Software (OBS/Streamlabs)</label>
                            <input type="text" name="software_version" class="w-full bg-surface-container-high border border-white/10 rounded-xl px-4 py-3 text-white focus:border-primary transition-colors focus:outline-none" placeholder="e.g. OBS Studio 28+">
                        </div>
                    </div>
                </section>

                <hr class="border-white/5">

                <section>
                    <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary">upload_file</span>
                        Media & Files
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Preview Images <span class="text-red-400">*</span></label>
                            <div class="border-2 border-dashed border-white/20 rounded-xl p-8 text-center hover:border-primary/50 transition-colors bg-surface-container/30 relative">
                                <input type="file" name="previewImages" accept="image/png, image/jpeg, image/webp" multiple required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" onchange="previewFileLabel(this, 'previewLabel')">
                                <span class="material-symbols-outlined text-4xl text-primary mb-3">imagesmode</span>
                                <p class="text-sm font-semibold text-white mb-1">Upload Screenshots</p>
                                <p class="text-xs text-on-surface-variant" id="previewLabel">Click or drag images (Max 5)</p>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-on-surface-variant mb-2">Overlay Package (ZIP/RAR) <span class="text-red-400">*</span></label>
                            <div class="border-2 border-dashed border-white/20 rounded-xl p-8 text-center hover:border-secondary/50 transition-colors bg-surface-container/30 relative">
                                <input type="file" name="zipFile" accept=".zip,.rar,.7z" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" onchange="previewFileLabel(this, 'zipLabel')">
                                <span class="material-symbols-outlined text-4xl text-secondary mb-3">folder_zip</span>
                                <p class="text-sm font-semibold text-white mb-1">Upload Project File</p>
                                <p class="text-xs text-on-surface-variant" id="zipLabel">Click or drag ZIP/RAR file</p>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="pt-6 flex justify-end">
                    <button type="submit" id="btnSubmitForm" class="px-8 py-3 primary-gradient rounded-xl font-bold text-white shadow-lg shadow-primary/25 hover:brightness-110 hover:scale-105 transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">rocket_launch</span>
                        Publish to Marketplace
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        function previewFileLabel(input, labelId) {
            const label = document.getElementById(labelId);
            if (input.files && input.files.length > 0) {
                if (input.files.length === 1) {
                    label.textContent = input.files[0].name;
                } else {
                    label.textContent = `${input.files.length} files selected`;
                }
                label.classList.add('text-primary');
                label.classList.remove('text-on-surface-variant');
            }
        }

        document.getElementById('uploadForm').addEventListener('submit', function() {
            const btn = document.getElementById('btnSubmitForm');
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-sm">progress_activity</span> Uploading... Please wait.';
            btn.classList.add('opacity-75', 'cursor-not-allowed');
        });
    </script>
</body>
</html>
