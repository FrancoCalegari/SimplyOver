<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title><%= typeof title !== 'undefined' ? title : 'SimplyOver' %></title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#d2bbff",
                        "secondary": "#4cd7f6",
                        "tertiary": "#ddb7ff",
                        "background": "#13131a",
                        "on-background": "#e4e1ec",
                        "surface": "#13131a",
                        "on-surface": "#e4e1ec",
                        "surface-container": "#1f1f26",
                        "surface-container-low": "#1b1b22",
                        "surface-container-lowest": "#0e0e15",
                        "surface-container-high": "#2a2931",
                        "surface-container-highest": "#34343c",
                        "surface-variant": "#34343c",
                        "primary-container": "#7c3aed",
                        "secondary-container": "#03b5d3",
                        "tertiary-container": "#8d36db",
                        "on-surface-variant": "#ccc3d8",
                        "secondary-fixed": "#acedff",
                        "primary-fixed-dim": "#d2bbff",
                        "outline-variant": "#4a4455",
                        "error": "#f87171"
                    },
                    "fontFamily": {
                        "headline-xl": ["Inter"],
                        "headline-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "label-sm": ["Inter"]
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<!-- ════════════════════════════════════════════════════════
     CHAT FLOTANTE IA — Aparece en todas las páginas
     ════════════════════════════════════════════════════════ -->
<div id="ai-chat-widget" style="position:fixed;bottom:24px;right:24px;z-index:9999;font-family:'Inter',sans-serif;">
  <!-- Bubble toggle button -->
  <button id="ai-chat-toggle"
          onclick="toggleAIChat()"
          style="width:56px;height:56px;border-radius:9999px;background:linear-gradient(135deg,#7c3aed,#4cd7f6);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 30px rgba(124,58,237,0.4);transition:all 0.3s;position:relative;">
    <span class="material-symbols-outlined" style="color:white;font-size:24px;transition:all 0.3s;" id="ai-chat-icon">auto_awesome</span>
    <!-- Unread badge -->
    <span id="ai-chat-badge" style="display:none;position:absolute;top:-4px;right:-4px;width:18px;height:18px;background:#ef4444;border-radius:9999px;font-size:10px;color:white;display:flex;align-items:center;justify-content:center;font-weight:700;">1</span>
  </button>

  <!-- Chat window -->
  <div id="ai-chat-window" style="display:none;position:absolute;bottom:68px;right:0;width:360px;max-height:500px;border-radius:20px;overflow:hidden;background:#1f1f26;border:1px solid rgba(255,255,255,0.08);box-shadow:0 20px 60px rgba(0,0,0,0.5);flex-direction:column;">
    <!-- Header -->
    <div style="padding:16px 20px;background:linear-gradient(135deg,rgba(124,58,237,0.3),rgba(76,215,246,0.1));border-bottom:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:space-between;">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="width:36px;height:36px;border-radius:9999px;background:linear-gradient(135deg,#7c3aed,#4cd7f6);display:flex;align-items:center;justify-content:center;">
          <span class="material-symbols-outlined" style="color:white;font-size:18px;">auto_awesome</span>
        </div>
        <div>
          <p style="color:white;font-weight:700;font-size:14px;margin:0;">SimplyOver AI</p>
          <p style="color:#4cd7f6;font-size:11px;margin:0;display:flex;align-items:center;gap:4px;">
            <span style="width:6px;height:6px;background:#22c55e;border-radius:9999px;display:inline-block;animation:pulse 2s infinite;"></span>
            Online
          </p>
        </div>
      </div>
      <button onclick="toggleAIChat()" style="background:none;border:none;cursor:pointer;color:rgba(255,255,255,0.4);padding:4px;border-radius:8px;transition:color 0.2s;" onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">
        <span class="material-symbols-outlined" style="font-size:20px;">close</span>
      </button>
    </div>

    <!-- Messages area -->
    <div id="ai-messages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;max-height:320px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,0.1) transparent;">
      <div class="ai-msg-bot" style="display:flex;align-items:flex-end;gap:8px;">
        <div style="width:28px;height:28px;border-radius:9999px;background:linear-gradient(135deg,#7c3aed,#4cd7f6);flex-shrink:0;display:flex;align-items:center;justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:14px;color:white;">auto_awesome</span>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.06);border-radius:16px;border-bottom-left-radius:4px;padding:10px 14px;max-width:80%;">
          <p style="color:#e4e1ec;font-size:13px;margin:0;line-height:1.5;">¡Hola! Soy tu asistente de SimplyOver 👋 ¿Buscás algún overlay en especial? Puedo ayudarte a encontrar el perfecto.</p>
        </div>
      </div>
    </div>

    <!-- Suggestions -->
    <div style="padding:8px 16px;display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;" id="ai-suggestions">
      <button onclick="sendAISuggestion(this)" style="padding:6px 12px;background:rgba(210,187,255,0.08);border:1px solid rgba(210,187,255,0.15);border-radius:9999px;color:#d2bbff;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.background='rgba(210,187,255,0.15)'" onmouseout="this.style.background='rgba(210,187,255,0.08)'">Overlays gratuitos 🎁</button>
      <button onclick="sendAISuggestion(this)" style="padding:6px 12px;background:rgba(76,215,246,0.08);border:1px solid rgba(76,215,246,0.15);border-radius:9999px;color:#4cd7f6;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.background='rgba(76,215,246,0.15)'" onmouseout="this.style.background='rgba(76,215,246,0.08)'">Estilo cyberpunk ⚡</button>
      <button onclick="sendAISuggestion(this)" style="padding:6px 12px;background:rgba(221,183,255,0.08);border:1px solid rgba(221,183,255,0.15);border-radius:9999px;color:#ddb7ff;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s;" onmouseover="this.style.background='rgba(221,183,255,0.15)'" onmouseout="this.style.background='rgba(221,183,255,0.08)'">¿Cómo funciona? 💡</button>
    </div>

    <!-- Input -->
    <div style="padding:12px 16px;border-top:1px solid rgba(255,255,255,0.06);display:flex;gap:8px;align-items:center;">
      <input id="ai-chat-input" type="text" placeholder="Ask me anything..."
             onkeydown="if(event.key==='Enter')sendAIMessage()"
             style="flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:9999px;padding:10px 16px;color:white;font-size:13px;outline:none;font-family:'Inter',sans-serif;transition:border-color 0.2s;"
             onfocus="this.style.borderColor='rgba(124,58,237,0.5)'"
             onblur="this.style.borderColor='rgba(255,255,255,0.08)'"/>
      <button onclick="sendAIMessage()"
              style="width:38px;height:38px;border-radius:9999px;background:linear-gradient(135deg,#7c3aed,#4cd7f6);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.2s;flex-shrink:0;"
              onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
        <span class="material-symbols-outlined" style="color:white;font-size:18px;">send</span>
      </button>
    </div>
  </div>
</div>

<style>
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
.ai-typing-dot { width:6px;height:6px;border-radius:9999px;background:#ccc3d8;animation:typing 1.2s ease-in-out infinite; }
.ai-typing-dot:nth-child(2){animation-delay:0.2s}
.ai-typing-dot:nth-child(3){animation-delay:0.4s}
@keyframes typing { 0%,80%,100%{transform:scale(0.7);opacity:0.4} 40%{transform:scale(1);opacity:1} }
</style>

<script>
  let aiChatHistory = [];
  let isAiChatOpen = false;

  function toggleAIChat() {
    isAiChatOpen = !isAiChatOpen;
    const win = document.getElementById('ai-chat-window');
    const icon = document.getElementById('ai-chat-icon');
    const badge = document.getElementById('ai-chat-badge');
    if (isAiChatOpen) {
      win.style.display = 'flex';
      win.style.flexDirection = 'column';
      icon.textContent = 'close';
      badge.style.display = 'none';
      setTimeout(() => document.getElementById('ai-chat-input')?.focus(), 100);
    } else {
      win.style.display = 'none';
      icon.textContent = 'auto_awesome';
    }
  };

  function sendAISuggestion(btn) {
    const msg = btn.textContent.replace(/[^\w\sá-ú¿!]/gu, '').trim();
    document.getElementById('ai-chat-input').value = msg;
    sendAIMessage();
  };

  async function sendAIMessage() {
    const input = document.getElementById('ai-chat-input');
    const content = input.value.trim();
    if (!content) return;
    input.value = '';

    appendMessage('user', content);
    aiChatHistory.push({ role: 'user', content });

    // Typing indicator
    const typingId = appendTyping();

    try {
      const r = await fetch('/api/ai-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: content, history: aiChatHistory.slice(-8) }),
      });
      removeTyping(typingId);

      if (r.ok) {
        const data = await r.json();
        appendMessage('bot', data.reply);
        aiChatHistory.push({ role: 'assistant', content: data.reply });
      } else {
        appendMessage('bot', 'Ups, tuve un problema. ¿Podés intentarlo de nuevo?');
      }
    } catch(e) {
      removeTyping(typingId);
      appendMessage('bot', 'Sin conexión. Verificá tu internet e intentalo de nuevo.');
    }
  };

  function appendMessage(role, text) {
    const container = document.getElementById('ai-messages');
    const isBot = role === 'bot';
    const div = document.createElement('div');
    div.style.cssText = `display:flex;align-items:flex-end;gap:8px;${isBot ? '' : 'flex-direction:row-reverse;'}`;

    // Basic markdown parsing for bold and italic
    const parsedText = text.replace(/</g, '&lt;')
                           .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                           .replace(/\*(.*?)\*/g, '<em>$1</em>');

    if (isBot) {
      div.innerHTML = `
        <div style="width:28px;height:28px;border-radius:9999px;background:linear-gradient(135deg,#7c3aed,#4cd7f6);flex-shrink:0;display:flex;align-items:center;justify-content:center;">
          <span class="material-symbols-outlined" style="font-size:14px;color:white;">auto_awesome</span>
        </div>
        <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.06);border-radius:16px;border-bottom-left-radius:4px;padding:10px 14px;max-width:80%;">
          <p style="color:#e4e1ec;font-size:13px;margin:0;line-height:1.5;">${parsedText}</p>
        </div>`;
    } else {
      div.innerHTML = `
        <div style="background:linear-gradient(135deg,#7c3aed,#d2bbff);border-radius:16px;border-bottom-right-radius:4px;padding:10px 14px;max-width:80%;">
          <p style="color:white;font-size:13px;margin:0;line-height:1.5;">${parsedText}</p>
        </div>`;
    }

    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
    return div;
  }

  function appendTyping() {
    const container = document.getElementById('ai-messages');
    const div = document.createElement('div');
    div.style.cssText = 'display:flex;align-items:flex-end;gap:8px;';
    div.innerHTML = `
      <div style="width:28px;height:28px;border-radius:9999px;background:linear-gradient(135deg,#7c3aed,#4cd7f6);flex-shrink:0;display:flex;align-items:center;justify-content:center;">
        <span class="material-symbols-outlined" style="font-size:14px;color:white;">auto_awesome</span>
      </div>
      <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.06);border-radius:16px;border-bottom-left-radius:4px;padding:12px 16px;display:flex;gap:4px;align-items:center;">
        <div class="ai-typing-dot"></div>
        <div class="ai-typing-dot"></div>
        <div class="ai-typing-dot"></div>
      </div>`;
    div.id = 'typing-' + Date.now();
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
    return div.id;
  }

  function removeTyping(id) {
    document.getElementById(id)?.remove();
  }
</script>
