<!DOCTYPE html>
<html class="dark" lang="en">
<%- include('partials/head', {title: (typeof overlay !== 'undefined' && overlay ? overlay.name + ' | SimplyOver' : 'Overlay Details | SimplyOver')}) %>
<%
  const _ov = (typeof overlay !== 'undefined') ? overlay : null;
  const _sw = (typeof spiderwebUrl !== 'undefined') ? spiderwebUrl : '';
  const _reviews = (typeof reviews !== 'undefined') ? reviews : [];
  const _cats = (typeof overlayCategories !== 'undefined') ? overlayCategories : [];
  const _isFav = (typeof isFavorite !== 'undefined') ? isFavorite : false;
  const _purchase = (typeof userPurchase !== 'undefined') ? userPurchase : null;
  const _isPaid = _ov && parseFloat(_ov.price) > 0;
%>
<body class="bg-background selection:bg-primary/30 selection:text-primary">
    <%- include('partials/navbar') %>

    <% if (!_ov) { %>
    <div class="flex flex-col items-center justify-center min-h-screen text-center px-6">
      <span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4">search_off</span>
      <h1 class="text-3xl font-bold text-white mb-2">Overlay not found</h1>
      <p class="text-on-surface-variant mb-6">This overlay may have been removed or is no longer available.</p>
      <a href="/" class="px-6 py-3 rounded-full bg-primary/10 border border-primary/30 text-primary font-semibold">Back to Marketplace</a>
    </div>
    <% } else { %>

    <main class="max-w-[1440px] mx-auto px-5 md:px-12 py-12">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 mb-8 text-on-surface-variant text-xs font-semibold flex-wrap">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <% _cats.forEach(function(cat, i) { %>
              <a class="hover:text-primary transition-colors" href="/?category=<%= cat.slug %>"><%= cat.name %></a>
              <% if (i < _cats.length - 1) { %>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
              <% } %>
            <% }); %>
            <% if (_cats.length > 0) { %>
              <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <% } %>
            <span class="text-primary font-bold"><%= _ov.name %></span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-10 items-start">
            <!-- LEFT COLUMN -->
            <div class="space-y-10">
                <!-- Main Preview -->
                <% const firstPreview = _ov.previewIds && _ov.previewIds[0] ? '/api/files/' + _ov.previewIds[0] : 'https://via.placeholder.com/1280x720/13131a/d2bbff?text=' + encodeURIComponent(_ov.name); %>
                <section class="relative group aspect-video rounded-2xl overflow-hidden" style="background: rgba(31,31,38,0.8);">
                    <img id="main-preview-img" alt="<%= _ov.name %> Preview"
                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                         src="<%= firstPreview %>"
                         onerror="this.src='https://via.placeholder.com/1280x720/13131a/d2bbff?text=No+Preview'"/>
                    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent pointer-events-none"></div>
                    <!-- View count badge -->
                    <div class="absolute bottom-4 right-4 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-white" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(8px);">
                      <span class="material-symbols-outlined text-[14px]">visibility</span>
                      <%= (_ov.view_count || 0).toLocaleString() %> views
                    </div>
                </section>

                <!-- Thumbnail Strip -->
                <% if (_ov.previewIds && _ov.previewIds.length > 1) { %>
                <section class="grid gap-3" style="grid-template-columns: repeat(<%= Math.min(_ov.previewIds.length, 5) %>, 1fr)">
                    <% _ov.previewIds.slice(0, 5).forEach(function(pid, idx) { %>
                    <div class="aspect-video rounded-xl overflow-hidden cursor-pointer border-2 transition-all duration-200 <%= idx === 0 ? 'border-primary' : 'border-white/10 hover:border-primary/50' %>"
                         onclick="switchPreview('/api/files/<%= pid %>', this)">
                        <img class="w-full h-full object-cover <%= idx === 0 ? 'opacity-100' : 'opacity-60 hover:opacity-90' %> transition-opacity"
                             src="/api/files/<%= pid %>" alt="Preview <%= idx + 1 %>"/>
                    </div>
                    <% }); %>
                </section>
                <% } %>

                <!-- Description -->
                <section class="glass-panel rounded-2xl p-8 space-y-4">
                  <h2 class="text-xl font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">description</span>
                    About this overlay
                  </h2>
                  <p class="text-on-surface-variant leading-relaxed whitespace-pre-line"><%= _ov.description || _ov.short_description || 'No description provided.' %></p>
                  <% if (_ov.tags && _ov.tags.length > 0) { %>
                  <div class="flex flex-wrap gap-2 pt-2">
                    <% _ov.tags.forEach(function(tag) { %>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-on-surface-variant"><%= tag %></span>
                    <% }); %>
                  </div>
                  <% } %>
                </section>

                <!-- Reviews Section -->
                <section class="space-y-6">
                    <div class="flex items-center justify-between">
                        <h2 class="text-2xl font-bold text-on-surface">Community Reviews
                          <span class="text-on-surface-variant text-base font-normal ml-2">(<%= _reviews.length %>)</span>
                        </h2>
                    </div>
                    <% if (_reviews.length === 0) { %>
                    <div class="glass-panel rounded-2xl p-10 text-center">
                      <span class="material-symbols-outlined text-4xl text-on-surface-variant/30 mb-3 block">rate_review</span>
                      <p class="text-on-surface-variant">No reviews yet. Be the first to share your experience!</p>
                    </div>
                    <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <% _reviews.forEach(function(rev) { %>
                        <div class="glass-panel p-6 rounded-2xl space-y-3">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center font-bold text-secondary overflow-hidden">
                                      <% if (rev.avatar_storage_id) { %>
                                        <img src="/api/files/<%= rev.avatar_storage_id %>" class="w-full h-full object-cover"/>
                                      <% } else { %>
                                        <%= (rev.display_name || rev.username || '?')[0].toUpperCase() %>
                                      <% } %>
                                    </div>
                                    <div>
                                        <div class="font-semibold text-sm text-white"><%= rev.display_name || rev.username %></div>
                                        <div class="text-[10px] text-on-surface-variant">@<%= rev.username %></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-1 text-secondary">
                                    <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                    <span class="font-bold"><%= rev.rating %>/10</span>
                                </div>
                            </div>
                            <% if (rev.title) { %><p class="font-semibold text-sm text-white"><%= rev.title %></p><% } %>
                            <% if (rev.body) { %><p class="text-on-surface-variant text-sm leading-relaxed"><%= rev.body %></p><% } %>
                            <p class="text-[10px] text-on-surface-variant/50"><%= new Date(rev.created_at).toLocaleDateString() %></p>
                        </div>
                        <% }); %>
                    </div>
                    <% } %>
                </section>
            </div>

            <!-- RIGHT COLUMN (Sticky) -->
            <aside class="lg:sticky lg:top-28 space-y-5">

                <!-- Product Title & Price -->
                <div class="glass-panel p-7 rounded-2xl space-y-5">
                  <h1 class="text-2xl font-bold text-on-surface leading-tight"><%= _ov.name %></h1>
                  <% if (_ov.short_description) { %>
                  <p class="text-on-surface-variant text-sm leading-relaxed"><%= _ov.short_description %></p>
                  <% } %>

                  <!-- Categories chips -->
                  <% if (_cats.length > 0) { %>
                  <div class="flex flex-wrap gap-2">
                    <% _cats.forEach(function(cat) { %>
                    <a href="/?category=<%= cat.slug %>" class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-on-surface-variant text-xs font-semibold hover:border-primary/30 hover:text-primary transition-all"><%= cat.name %></a>
                    <% }); %>
                  </div>
                  <% } %>

                  <!-- Price & CTA -->
                  <div class="border-t border-white/5 pt-5">
                    <div class="text-on-surface-variant text-xs font-semibold uppercase tracking-widest mb-1">Price</div>
                    <% if (_isPaid) { %>
                    <div class="text-4xl font-bold text-white mb-5">$<%= parseFloat(_ov.price).toFixed(2) %> <span class="text-lg text-on-surface-variant font-normal"><%= _ov.currency || 'ARS' %></span></div>
                    <% } else { %>
                    <div class="text-4xl font-bold text-secondary mb-5">FREE</div>
                    <% } %>

                    <!-- Actions -->
                    <div class="space-y-3">
                      <% if (_purchase) { %>
                        <!-- Ya tiene acceso → botón de descarga -->
                        <a href="/download/<%= _purchase.download_token %>"
                           class="w-full flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-white text-lg transition-all hover:scale-[1.02] shadow-lg"
                           style="background: linear-gradient(45deg, #4cd7f6, #06b6d4); box-shadow: 0 0 20px rgba(76,215,246,0.25);">
                          <span class="material-symbols-outlined text-[22px]">download</span>
                          Download (<%= _purchase.download_count %>/<%= _purchase.download_limit %>)
                        </a>
                      <% } else if (!_isPaid) { %>
                        <!-- Overlay gratuito → descarga directa -->
                        <% if (typeof user !== 'undefined' && user) { %>
                        <button id="free-download-btn" onclick="downloadFree('<%= _ov.id %>')"
                           class="w-full flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-white text-lg transition-all hover:scale-[1.02] shadow-lg"
                           style="background: linear-gradient(45deg, #4cd7f6, #06b6d4); box-shadow: 0 0 20px rgba(76,215,246,0.25);">
                          <span class="material-symbols-outlined text-[22px]">download</span>
                          Download Free
                        </button>
                        <% } else { %>
                        <a href="/login?returnTo=/overlay/<%= _ov.slug %>"
                           class="w-full flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-white text-lg transition-all hover:scale-[1.02] shadow-lg"
                           style="background: linear-gradient(45deg, #4cd7f6, #06b6d4);">
                          <span class="material-symbols-outlined text-[22px]">login</span>
                          Sign in to Download
                        </a>
                        <% } %>
                      <% } else { %>
                        <!-- Overlay de pago -->
                        <button class="w-full flex items-center justify-center gap-2 py-4 rounded-xl font-bold text-white text-lg transition-all hover:scale-[1.02] shadow-lg"
                                style="background: linear-gradient(45deg, #7c3aed, #ddb7ff); box-shadow: 0 0 20px rgba(124,58,237,0.25);"
                                onclick="alert('Payment system coming soon!')">
                          <span class="material-symbols-outlined text-[22px]">shopping_cart</span>
                          Buy Now
                        </button>
                      <% } %>

                      <!-- Favorito + Board -->
                      <div class="grid grid-cols-2 gap-3">
                        <button id="fav-btn" onclick="toggleFav('<%= _ov.id %>')"
                                class="flex items-center justify-center gap-2 py-3 rounded-xl font-semibold text-sm transition-all border"
                                style="background: rgba(255,255,255,0.04); border-color: <%= _isFav ? 'rgba(239,68,68,0.5)' : 'rgba(255,255,255,0.1)' %>; color: <%= _isFav ? '#ef4444' : '#ccc3d8' %>">
                          <span class="material-symbols-outlined text-[20px]" id="fav-icon" style="font-variation-settings: '<%= _isFav ? 'FILL' : '' %> 1'"><%= _isFav ? 'favorite' : 'favorite_border' %></span>
                          <%= _isFav ? 'Favorited' : 'Favorite' %>
                        </button>
                        <button onclick="if(typeof openBoardSelector==='function') openBoardSelector('<%= _ov.id %>'); else alert('Login required')"
                                class="flex items-center justify-center gap-2 py-3 rounded-xl font-semibold text-sm transition-all border border-white/10 text-on-surface-variant hover:border-secondary/30 hover:text-secondary"
                                style="background: rgba(255,255,255,0.04);">
                          <span class="material-symbols-outlined text-[20px]">push_pin</span>
                          Save to Board
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Creator Card -->
                <div class="glass-panel p-5 rounded-2xl flex items-center justify-between">
                    <a href="/artist/<%= _ov.creator_username %>" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
                        <div class="w-12 h-12 rounded-full overflow-hidden border border-white/20 bg-primary/10 flex items-center justify-center">
                            <% if (_ov.creator_avatar) { %>
                            <img class="w-full h-full object-cover" src="/api/files/<%= _ov.creator_avatar %>" alt="<%= _ov.creator_username %>"/>
                            <% } else { %>
                            <span class="material-symbols-outlined text-primary text-[22px]">person</span>
                            <% } %>
                        </div>
                        <div>
                            <p class="font-semibold text-sm text-on-surface"><%= _ov.creator_display_name || _ov.creator_username %></p>
                            <p class="text-xs text-on-surface-variant">@<%= _ov.creator_username %></p>
                        </div>
                    </a>
                    <a href="/messages/<%= _ov.creator_username %>" class="p-2 rounded-lg transition-all text-on-surface-variant hover:text-secondary hover:bg-secondary/10" title="Send message">
                      <span class="material-symbols-outlined text-[20px]">mail</span>
                    </a>
                </div>

                <!-- Technical Specs -->
                <div class="glass-panel p-6 rounded-2xl space-y-4">
                    <div class="flex items-center gap-2 text-primary">
                        <span class="material-symbols-outlined">settings_input_component</span>
                        <h3 class="font-semibold text-sm uppercase tracking-wider">Technical Info</h3>
                    </div>
                    <div class="space-y-3 text-sm">
                        <% if (_ov.resolution) { %>
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span class="text-on-surface-variant">Resolution</span>
                            <span class="text-on-surface font-semibold"><%= _ov.resolution %></span>
                        </div>
                        <% } %>
                        <% if (_ov.software_version) { %>
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span class="text-on-surface-variant">OBS Version</span>
                            <span class="text-on-surface font-semibold"><%= _ov.software_version %>+</span>
                        </div>
                        <% } %>
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span class="text-on-surface-variant">Downloads</span>
                            <span class="text-on-surface font-semibold"><%= (_ov.download_count || 0).toLocaleString() %></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-on-surface-variant">Published</span>
                            <span class="text-on-surface font-semibold"><%= _ov.published_at ? new Date(_ov.published_at).toLocaleDateString() : 'N/A' %></span>
                        </div>
                    </div>
                </div>

                <!-- Share -->
                <div class="flex items-center justify-between px-2">
                    <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.querySelector('span.text-label').textContent='Copied!';setTimeout(()=>this.querySelector('span.text-label').textContent='Copy Link',2000)})"
                            class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[20px]">content_copy</span>
                        <span class="text-xs font-semibold text-label">Copy Link</span>
                    </button>
                    <div class="flex gap-2">
                        <a class="p-2 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-secondary/10 transition-all" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent('https://simplyover.com/overlay/' + _ov.slug) %>&text=<%= encodeURIComponent('Check out this overlay: ' + _ov.name) %>" target="_blank" title="Share on X">
                          <span class="material-symbols-outlined text-[20px]">share</span>
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <%- include('partials/board_selector') %>
    <%- include('partials/footer') %>

    <script>
        // Thumbnail switcher
        function switchPreview(url, el) {
            document.getElementById('main-preview-img').src = url;
            document.querySelectorAll('.aspect-video.rounded-xl.cursor-pointer').forEach(t => {
                t.classList.remove('border-primary');
                t.classList.add('border-white/10');
                t.querySelector('img')?.classList.remove('opacity-100');
                t.querySelector('img')?.classList.add('opacity-60');
            });
            el.classList.add('border-primary');
            el.classList.remove('border-white/10');
            el.querySelector('img')?.classList.add('opacity-100');
            el.querySelector('img')?.classList.remove('opacity-60');
        }

        // Favorito toggle
        async function toggleFav(overlayId) {
            <% if (typeof user === 'undefined' || !user) { %>
            window.location.href = '/login?returnTo=' + encodeURIComponent(window.location.pathname);
            return;
            <% } %>
            const btn = document.getElementById('fav-btn');
            const icon = document.getElementById('fav-icon');
            try {
                const r = await fetch('/api/favorites', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ overlayId })
                });
                if (r.status === 401) { window.location.href = '/login'; return; }
                const data = await r.json();
                if (data.action === 'added') {
                    icon.textContent = 'favorite';
                    icon.style.fontVariationSettings = "'FILL' 1";
                    btn.style.color = '#ef4444';
                    btn.style.borderColor = 'rgba(239,68,68,0.5)';
                    btn.querySelector(':last-child').textContent = 'Favorited';
                } else {
                    icon.textContent = 'favorite_border';
                    icon.style.fontVariationSettings = "";
                    btn.style.color = '#ccc3d8';
                    btn.style.borderColor = 'rgba(255,255,255,0.1)';
                    btn.querySelector(':last-child').textContent = 'Favorite';
                }
            } catch(e) { console.error(e); }
        }

        // Descarga gratuita
        async function downloadFree(overlayId) {
            const btn = document.getElementById('free-download-btn');
            if (!btn) return;
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined text-[22px] animate-spin">refresh</span> Processing...';
            try {
                const r = await fetch('/download/purchase/free', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ overlayId })
                });
                const data = await r.json();
                if (data.success && data.token) {
                    window.location.href = '/download/' + data.token;
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<span class="material-symbols-outlined text-[22px]">download</span> Download Free';
                    alert(data.error || 'Error processing download.');
                }
            } catch(e) {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined text-[22px]">download</span> Download Free';
                alert('Network error. Please try again.');
            }
        }
    </script>
</body>
</html>
<% } %>
