<!DOCTYPE html>
<html lang="es" class="dark">
<%- include('partials/head') %>

<body class="bg-[#0D0D14] text-[#e4e1ec] min-h-screen flex flex-col font-['Inter',sans-serif]">
  <%- include('partials/navbar') %>

  <!-- Confetti si aprobado -->
  <% if (status === 'approved') { %>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script>
    window.addEventListener('load', () => {
      if (typeof confetti === 'function') {
        confetti({ particleCount: 90, spread: 80, origin: { y: 0.5 } });
      }
    });
  </script>
  <% } %>

  <main class="flex-1 max-w-3xl w-full mx-auto px-4 sm:px-6 py-12 flex items-center justify-center">
    <div class="w-full bg-[#151522] border border-white/10 rounded-3xl p-8 md:p-10 shadow-2xl text-center relative overflow-hidden">

      <% if (status === 'approved') { %>
        <!-- ÉXITO -->
        <div class="w-20 h-20 mx-auto rounded-full bg-emerald-500/20 border-2 border-emerald-500 flex items-center justify-center text-emerald-400 shadow-lg shadow-emerald-500/20 mb-6">
          <span class="material-symbols-outlined text-4xl">check</span>
        </div>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 uppercase tracking-wider mb-2">
          ¡Operación Exitosa!
        </span>
        <h1 class="text-2xl md:text-3xl font-extrabold text-white mb-2">¡Gracias por tu compra!</h1>
        <p class="text-xs text-on-surface-variant max-w-md mx-auto mb-6"><%= message %></p>

        <div class="rounded-2xl bg-black/40 border border-white/10 p-5 text-xs font-mono text-left space-y-2 mb-8 max-w-md mx-auto">
          <div class="flex justify-between text-white/60">
            <span>ID de Transacción:</span>
            <span class="text-white font-bold"><%= paymentId %></span>
          </div>
          <div class="flex justify-between text-white/60">
            <span>Estado:</span>
            <span class="text-emerald-400 font-bold">APROBADO (Mercado Pago)</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
          <a href="/dashboard/library" class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-white text-sm bg-gradient-to-r from-primary-container to-secondary-container hover:opacity-90 transition-all shadow-lg flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">library_music</span>
            <span>Ir a Mi Biblioteca</span>
          </a>
          <a href="/" class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-bold text-on-surface-variant hover:text-white text-sm bg-white/5 hover:bg-white/10 border border-white/10 transition-all flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-[18px]">storefront</span>
            <span>Explorar más overlays</span>
          </a>
        </div>

      <% } else if (status === 'pending') { %>
        <!-- PENDIENTE -->
        <div class="w-20 h-20 mx-auto rounded-full bg-amber-500/20 border-2 border-amber-500 flex items-center justify-center text-amber-400 shadow-lg shadow-amber-500/20 mb-6">
          <span class="material-symbols-outlined text-4xl">hourglass_top</span>
        </div>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-500/15 text-amber-400 border border-amber-500/30 uppercase tracking-wider mb-2">
          Acreditación en Proceso
        </span>
        <h1 class="text-2xl md:text-3xl font-extrabold text-white mb-2">Pago Pendiente</h1>
        <p class="text-xs text-on-surface-variant max-w-md mx-auto mb-6"><%= message %></p>

        <div class="flex justify-center gap-3">
          <a href="/dashboard/library" class="px-6 py-3.5 rounded-xl font-bold text-white text-sm bg-white/10 hover:bg-white/15 border border-white/10 transition-all">
            Ver Mi Biblioteca
          </a>
        </div>

      <% } else { %>
        <!-- RECHAZADO -->
        <div class="w-20 h-20 mx-auto rounded-full bg-red-500/20 border-2 border-red-500 flex items-center justify-center text-red-400 shadow-lg shadow-red-500/20 mb-6">
          <span class="material-symbols-outlined text-4xl">close</span>
        </div>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-red-500/15 text-red-400 border border-red-500/30 uppercase tracking-wider mb-2">
          Operación No Completada
        </span>
        <h1 class="text-2xl md:text-3xl font-extrabold text-white mb-2">Pago Rechazado</h1>
        <p class="text-xs text-on-surface-variant max-w-md mx-auto mb-6"><%= message %></p>

        <div class="flex justify-center gap-3">
          <a href="/checkout/<%= overlayId || 'demo' %>" class="px-6 py-3.5 rounded-xl font-bold text-white text-sm bg-gradient-to-r from-primary to-secondary hover:opacity-90 transition-all">
            Reintentar Compra
          </a>
        </div>
      <% } %>

    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
