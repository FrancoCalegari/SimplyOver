<!DOCTYPE html>
<html class="dark" lang="en">
<%- include('partials/head', {title: title || 'Error | SimplyOver'}) %>
<body class="bg-background text-on-background flex items-center justify-center min-h-screen">
  <div class="text-center px-6">
    <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-white/5 flex items-center justify-center">
      <span class="material-symbols-outlined text-primary text-5xl">error</span>
    </div>
    <h1 class="text-4xl font-bold text-white mb-3"><%= title || 'Error' %></h1>
    <p class="text-on-surface-variant max-w-md mx-auto mb-8"><%= typeof message !== 'undefined' ? message : 'Something went wrong.' %></p>
    <a href="/" class="px-8 py-3 rounded-full primary-gradient text-white font-bold hover:scale-[1.02] transition-all">
      Go Home
    </a>
  </div>
</body>
</html>
