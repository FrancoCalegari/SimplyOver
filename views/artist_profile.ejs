<!DOCTYPE html>
<html class="dark" lang="en">
<%- include('partials/head', {title: title || 'Artist Profile | SimplyOver'}) %>
<%
  const _a    = (typeof artist     !== 'undefined' && artist)     ? artist     : {};
  const _ov   = (typeof overlays   !== 'undefined')               ? overlays   : [];
  const _sw   = (typeof spiderwebUrl !== 'undefined')             ? spiderwebUrl : (process.env.SPIDERWEBURL || '');
  const _flrs = (typeof followers  !== 'undefined')               ? followers  : 0;
  const _fing = (typeof following  !== 'undefined')               ? following  : 0;
  const _isFlw= (typeof isFollowing!== 'undefined')               ? isFollowing: false;
  const _own  = (typeof isOwnProfile!== 'undefined')              ? isOwnProfile: false;

  const avatarUrl = _a.avatar_storage_id
    ? `/api/files/${_a.avatar_storage_id}`
    : null;
  const bannerUrl = _a.banner_storage_id
    ? `/api/files/${_a.banner_storage_id}`
    : null;
  const memberYear = _a.created_at ? new Date(_a.created_at).getFullYear() : '—';
%>
<body class="bg-background text-on-background">
  <%- include('partials/navbar') %>

  <div class="min-h-screen">

    <!-- ── Banner ────────────────────────────────────────────── -->
    <div class="relative w-full h-[260px] md:h-[320px] overflow-hidden" id="profile-banner">
      <% if (bannerUrl) { %>
      <img src="<%= bannerUrl %>" alt="Banner" class="w-full h-full object-cover brightness-75" id="banner-img"/>
      <% } else { %>
      <div class="w-full h-full" style="background: linear-gradient(135deg, #1a0a2e 0%, #16213e 40%, #0d1117 100%);">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 20% 50%, rgba(124,58,237,0.3) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(76,215,246,0.15) 0%, transparent 50%);"></div>
      </div>
      <% } %>
      <div class="absolute inset-0 bg-gradient-to-t from-background via-background/30 to-transparent"></div>

      <!-- Botón cambiar banner (solo el dueño del perfil) -->
      <% if (_own) { %>
      <label for="banner-input" class="absolute top-4 right-4 cursor-pointer px-3 py-2 rounded-lg bg-black/40 backdrop-blur-md text-white text-xs font-semibold border border-white/20 hover:bg-black/60 transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">add_a_photo</span> Change Banner
        <input type="file" id="banner-input" class="hidden" accept="image/*" onchange="uploadBanner(this)"/>
      </label>
      <% } %>
    </div>

    <!-- ── Perfil Header ─────────────────────────────────────── -->
    <div class="relative z-10 px-5 md:px-16 -mt-20">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">

        <!-- Avatar + nombre -->
        <div class="flex flex-col md:flex-row items-center md:items-end gap-5">
          <div class="relative group">
            <div class="w-32 h-32 rounded-full border-4 border-background overflow-hidden shadow-2xl bg-surface-container ring-2 ring-primary/30">
              <% if (avatarUrl) { %>
              <img src="<%= avatarUrl %>" alt="Avatar" class="w-full h-full object-cover" id="avatar-img"/>
              <% } else { %>
              <div class="w-full h-full bg-primary/10 flex items-center justify-center" id="avatar-img">
                <span class="material-symbols-outlined text-primary text-5xl">person</span>
              </div>
              <% } %>
            </div>
            <!-- Botón cambiar avatar (solo dueño) -->
            <% if (_own) { %>
            <label for="avatar-input" class="absolute inset-0 rounded-full cursor-pointer flex items-center justify-center bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="material-symbols-outlined text-white text-3xl">photo_camera</span>
              <input type="file" id="avatar-input" class="hidden" accept="image/*" onchange="uploadAvatar(this)"/>
            </label>
            <% } %>
          </div>

          <div class="text-center md:text-left pb-2">
            <h1 class="text-4xl md:text-5xl font-bold text-white leading-tight">
              <%= _a.display_name || _a.username || 'Artist' %>
            </h1>
            <p class="text-on-surface-variant text-lg mt-1">@<%= _a.username || '' %></p>
            <% if (_a.role === 'creator' || _a.role === 'admin') { %>
            <span class="inline-flex items-center gap-1 mt-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">
              <span class="material-symbols-outlined text-[14px]">verified</span> Verified Creator
            </span>
            <% } %>
          </div>
        </div>

        <!-- Acciones: Follow / Edit / Share -->
        <div class="flex items-center gap-3 justify-center md:justify-end pb-2 flex-wrap">
          <% if (_own) { %>
          <a href="/profile/settings"
             class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/10 text-on-surface-variant hover:text-white hover:bg-white/5 transition-all text-sm font-semibold">
            <span class="material-symbols-outlined text-[18px]">edit</span> Edit Profile
          </a>
          <% } else { %>
          <button id="follow-btn"
                  data-artist-id="<%= _a.id %>"
                  data-following="<%= _isFlw ? '1' : '0' %>"
                  onclick="toggleFollow(this)"
                  class="flex items-center gap-2 px-6 py-2.5 rounded-full font-semibold text-sm transition-all
                  <%= _isFlw
                    ? 'bg-white/5 border border-white/20 text-on-surface-variant hover:border-red-500/50 hover:text-red-400'
                    : 'text-background hover:opacity-90 hover:scale-[1.02]' %>"
                  style="<%= _isFlw ? '' : 'background: linear-gradient(45deg,#7c3aed,#ddb7ff)' %>">
            <span class="material-symbols-outlined text-[18px]"><%= _isFlw ? 'person_remove' : 'person_add' %></span>
            <span id="follow-label"><%= _isFlw ? 'Following' : 'Follow' %></span>
          </button>
          <% } %>

          <button onclick="shareProfile('<%= _a.username %>', '<%= (_a.display_name || _a.username || '').replace(/'/g, '') %>')"
                  class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/10 text-on-surface-variant hover:text-white hover:bg-white/5 transition-all text-sm font-semibold">
            <span class="material-symbols-outlined text-[18px]">share</span> Share
          </button>
        </div>
      </div>

      <!-- Bio -->
      <% if (_a.bio) { %>
      <p class="mt-6 text-on-surface-variant max-w-2xl text-base leading-relaxed"><%= _a.bio %></p>
      <% } %>

      <!-- Artist Tags -->
      <% if (_a.artist_tags_arr && _a.artist_tags_arr.length > 0) { %>
      <div class="flex flex-wrap gap-2 mt-4">
        <% _a.artist_tags_arr.forEach(function(tag) { %>
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20">#<%= tag %></span>
        <% }); %>
      </div>
      <% } %>

      <!-- Social Links -->
      <div class="flex flex-wrap gap-2 mt-5">
        <% if (_a.link_twitch) { %>
        <a href="<%= _a.link_twitch %>" target="_blank"
           class="p-2.5 rounded-full bg-[#9146FF]/10 text-[#9146FF] border border-[#9146FF]/20 hover:bg-[#9146FF]/20 transition-all" title="Twitch">
          <span class="material-symbols-outlined text-[20px]">videocam</span>
        </a>
        <% } %>
        <% if (_a.link_kick) { %>
        <a href="<%= _a.link_kick %>" target="_blank"
           class="p-2.5 rounded-full bg-[#53FC18]/10 text-[#53FC18] border border-[#53FC18]/20 hover:bg-[#53FC18]/20 transition-all" title="Kick">
          <span class="material-symbols-outlined text-[20px]">bolt</span>
        </a>
        <% } %>
        <% if (_a.link_instagram) { %>
        <a href="<%= _a.link_instagram %>" target="_blank"
           class="p-2.5 rounded-full bg-[#E4405F]/10 text-[#E4405F] border border-[#E4405F]/20 hover:bg-[#E4405F]/20 transition-all" title="Instagram">
          <span class="material-symbols-outlined text-[20px]">photo_camera</span>
        </a>
        <% } %>
        <% if (_a.link_tiktok) { %>
        <a href="<%= _a.link_tiktok %>" target="_blank"
           class="p-2.5 rounded-full bg-white/5 text-white border border-white/10 hover:bg-white/10 transition-all" title="TikTok">
          <span class="material-symbols-outlined text-[20px]">music_note</span>
        </a>
        <% } %>
        <% if (_a.link_web) { %>
        <a href="<%= _a.link_web %>" target="_blank"
           class="p-2.5 rounded-full bg-white/5 text-white border border-white/10 hover:bg-white/10 transition-all" title="Website">
          <span class="material-symbols-outlined text-[20px]">language</span>
        </a>
        <% } %>
        <% if (_a.link_email) { %>
        <a href="mailto:<%= _a.link_email %>"
           class="p-2.5 rounded-full bg-white/5 text-white border border-white/10 hover:bg-white/10 transition-all" title="Email">
          <span class="material-symbols-outlined text-[20px]">mail</span>
        </a>
        <% } %>
      </div>

      <!-- Stats Bar -->
      <div class="mt-10 grid grid-cols-2 md:flex md:items-center gap-8 py-6 border-y border-white/5">
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white"><%= _ov.length %></span>
          <span class="text-xs text-on-surface-variant uppercase tracking-wider">Overlays</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white" id="followers-count"><%= _flrs %></span>
          <span class="text-xs text-on-surface-variant uppercase tracking-wider">Followers</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white"><%= _fing %></span>
          <span class="text-xs text-on-surface-variant uppercase tracking-wider">Following</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white"><%= memberYear %></span>
          <span class="text-xs text-on-surface-variant uppercase tracking-wider">Member Since</span>
        </div>
      </div>

      <!-- Tabs -->
      <div class="mt-8 flex items-center gap-10 border-b border-white/5 overflow-x-auto">
        <button onclick="switchTab('designs', this)"
                id="tab-designs"
                class="pb-4 font-semibold text-secondary border-b-2 border-secondary whitespace-nowrap">
          Designs (<%= _ov.length %>)
        </button>
        <button onclick="switchTab('about', this)"
                id="tab-about"
                class="pb-4 text-on-surface-variant hover:text-white font-semibold transition-colors border-b-2 border-transparent whitespace-nowrap">
          About
        </button>
      </div>

      <!-- Tab: Designs -->
      <div id="panel-designs" class="mt-10 mb-24">
        <% if (_ov.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-24 border-2 border-dashed border-white/5 rounded-3xl">
          <span class="material-symbols-outlined text-on-surface-variant text-6xl mb-4">inventory_2</span>
          <p class="text-on-surface-variant text-lg">No overlays published yet.</p>
        </div>
        <% } else { %>
        <div class="masonry-grid">
          <% _ov.forEach(function(ov, i) { %>
          <%
            let prevUrl = '/img/default_cover.jpg';
            try {
              const ids = JSON.parse(ov.preview_storage_ids || '[]');
              if (ids[0]) prevUrl = '/api/files/' + ids[0];
            } catch(e) {}
            const premium = parseFloat(ov.price) > 0;
            const priceLabel = premium ? '$' + parseFloat(ov.price).toFixed(2) : 'FREE';
            const priceClass = premium ? 'bg-primary-container text-white' : 'bg-secondary/10 text-secondary border border-secondary/30';
            const heights = [240, 280, 200, 320, 260];
            const h = heights[i % 5];
          %>
          <article class="masonry-item group relative overflow-hidden rounded-xl glass-surface border border-white/10 hover:border-primary/30 transition-all duration-300 hover:scale-[1.02] cursor-pointer"
                   onclick="window.location.href='/overlay/<%= ov.slug || ov.id %>'">
            <div class="relative overflow-hidden">
              <img class="w-full object-cover rounded-t-xl transition-transform duration-500 group-hover:scale-105"
                   src="<%= prevUrl %>"
                   style="height: <%= h %>px;"
                   alt="<%= ov.name %>"
                   onerror="this.src='https://via.placeholder.com/400x280/1f1f26/d2bbff?text=Overlay'"/>
              <span class="absolute top-3 right-3 px-2.5 py-1 rounded-lg text-xs font-bold <%= priceClass %>"><%= priceLabel %></span>
              <div class="absolute inset-0 bg-background/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-3">
                <a href="/overlay/<%= ov.slug || ov.id %>"
                   class="px-4 py-2 rounded-lg bg-primary text-background text-sm font-semibold"
                   onclick="event.stopPropagation()">View</a>
              </div>
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-white text-sm mb-1 truncate"><%= ov.name %></h3>
              <div class="flex items-center justify-between">
                <% if (ov.avg_rating) { %>
                <div class="flex items-center gap-1 text-tertiary">
                  <span class="material-symbols-outlined text-[14px]" style="font-variation-settings:'FILL' 1">star</span>
                  <span class="text-xs font-semibold"><%= ov.avg_rating %></span>
                  <% if (ov.review_count) { %><span class="text-[10px] text-on-surface-variant">(<%= ov.review_count %>)</span><% } %>
                </div>
                <% } else { %>
                <span class="text-[11px] text-on-surface-variant">No reviews yet</span>
                <% } %>
                <span class="text-[10px] text-on-surface-variant"><%= ov.favorite_count || 0 %> ❤</span>
              </div>
            </div>
          </article>
          <% }); %>
        </div>
        <% } %>
      </div>

      <!-- Tab: About (oculto inicialmente) -->
      <div id="panel-about" class="hidden mt-10 mb-24 max-w-2xl">
        <div class="glass-surface rounded-2xl p-8 border border-white/10 space-y-6">
          <% if (_a.bio) { %>
          <div>
            <h2 class="text-lg font-bold text-white mb-2">About <%= _a.display_name || _a.username %></h2>
            <p class="text-on-surface-variant leading-relaxed"><%= _a.bio %></p>
          </div>
          <% } %>
          <div>
            <h3 class="text-sm font-bold text-on-surface-variant uppercase tracking-wider mb-3">Stats</h3>
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-surface-container/40 rounded-xl p-4">
                <p class="text-2xl font-bold text-white"><%= _ov.length %></p>
                <p class="text-xs text-on-surface-variant mt-1">Overlays published</p>
              </div>
              <div class="bg-surface-container/40 rounded-xl p-4">
                <p class="text-2xl font-bold text-white" id="about-followers"><%= _flrs %></p>
                <p class="text-xs text-on-surface-variant mt-1">Followers</p>
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-sm font-bold text-on-surface-variant uppercase tracking-wider mb-3">Member Since</h3>
            <p class="text-white font-semibold"><%= memberYear %></p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <%- include('partials/board_selector') %>
  <%- include('partials/footer') %>

  <!-- Share modal -->
  <div class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4" id="share-modal">
    <div class="absolute inset-0 bg-background/80 backdrop-blur-md" onclick="document.getElementById('share-modal').classList.add('hidden')"></div>
    <div class="glass-surface p-6 rounded-2xl w-full max-w-sm relative shadow-2xl border border-white/10 z-10">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">share</span> Share Profile
      </h2>
      <div class="bg-surface-container/60 rounded-xl px-4 py-3 flex items-center justify-between mb-4">
        <span id="share-url" class="text-on-surface-variant text-sm truncate"></span>
        <button onclick="copyShareUrl()" class="ml-2 text-primary hover:text-white transition-colors shrink-0" title="Copy">
          <span class="material-symbols-outlined text-[20px]">content_copy</span>
        </button>
      </div>
      <div class="flex gap-2 justify-center">
        <a id="share-twitter" href="#" target="_blank"
           class="flex-1 text-center py-2.5 rounded-xl bg-[#1DA1F2]/10 text-[#1DA1F2] border border-[#1DA1F2]/20 hover:bg-[#1DA1F2]/20 transition-all text-sm font-semibold">Twitter/X</a>
        <a id="share-wa" href="#" target="_blank"
           class="flex-1 text-center py-2.5 rounded-xl bg-[#25D366]/10 text-[#25D366] border border-[#25D366]/20 hover:bg-[#25D366]/20 transition-all text-sm font-semibold">WhatsApp</a>
      </div>
    </div>
  </div>

<style>
.masonry-grid { columns: 1; column-gap: 1.5rem; }
@media (min-width: 640px)  { .masonry-grid { columns: 2; } }
@media (min-width: 1024px) { .masonry-grid { columns: 3; } }
@media (min-width: 1280px) { .masonry-grid { columns: 4; } }
.masonry-item { break-inside: avoid; margin-bottom: 1.5rem; display: block; }
</style>

<script>
// ── Tabs ─────────────────────────────────────────────────────
function switchTab(name, btn) {
  document.querySelectorAll('[id^="panel-"]').forEach(p => p.classList.add('hidden'));
  document.querySelectorAll('[id^="tab-"]').forEach(b => {
    b.classList.remove('text-secondary', 'border-secondary', 'border-b-2');
    b.classList.add('text-on-surface-variant', 'border-transparent', 'border-b-2');
  });
  document.getElementById('panel-' + name)?.classList.remove('hidden');
  btn.classList.remove('text-on-surface-variant', 'border-transparent');
  btn.classList.add('text-secondary', 'border-secondary');
}

// ── Follow / Unfollow ────────────────────────────────────────
async function toggleFollow(btn) {
  if (!document.cookie.includes('so_token')) {
    return window.location.href = '/login?returnTo=' + encodeURIComponent(window.location.pathname);
  }
  const artistId  = btn.dataset.artistId;
  const following = btn.dataset.following === '1';
  const method    = following ? 'DELETE' : 'POST';

  try {
    const r = await fetch(`/profile/follow/${artistId}`, { method });
    const d = await r.json();
    if (d.success) {
      const nowFollowing = !following;
      btn.dataset.following = nowFollowing ? '1' : '0';

      // Actualizar label
      document.getElementById('follow-label').textContent = nowFollowing ? 'Following' : 'Follow';
      const icon = btn.querySelector('.material-symbols-outlined');
      icon.textContent = nowFollowing ? 'person_remove' : 'person_add';

      // Actualizar estilo
      if (nowFollowing) {
        btn.style.background = '';
        btn.classList.add('bg-white/5', 'border', 'border-white/20', 'text-on-surface-variant');
        btn.classList.remove('text-background');
      } else {
        btn.style.background = 'linear-gradient(45deg,#7c3aed,#ddb7ff)';
        btn.classList.remove('bg-white/5', 'border', 'border-white/20', 'text-on-surface-variant');
        btn.classList.add('text-background');
      }

      // Actualizar contadores
      const cnt = document.getElementById('followers-count');
      if (cnt) cnt.textContent = d.followers;
      const cntAbout = document.getElementById('about-followers');
      if (cntAbout) cntAbout.textContent = d.followers;
    }
  } catch(e) {
    alert('Error: ' + e.message);
  }
}

// ── Share ────────────────────────────────────────────────────
function shareProfile(username, displayName) {
  const url = window.location.origin + '/artist/' + username;
  document.getElementById('share-url').textContent = url;
  document.getElementById('share-twitter').href =
    `https://twitter.com/intent/tweet?text=Check+out+${encodeURIComponent(displayName)}+on+SimplyOver!&url=${encodeURIComponent(url)}`;
  document.getElementById('share-wa').href =
    `https://wa.me/?text=${encodeURIComponent(displayName + ' - SimplyOver\n' + url)}`;
  document.getElementById('share-modal').classList.remove('hidden');
}

async function copyShareUrl() {
  const url = document.getElementById('share-url').textContent;
  try {
    await navigator.clipboard.writeText(url);
    const btn = document.querySelector('#share-modal [title="Copy"] .material-symbols-outlined');
    btn.textContent = 'check';
    setTimeout(() => btn.textContent = 'content_copy', 1500);
  } catch(e) {}
}

// ── Avatar Upload ────────────────────────────────────────────
async function uploadAvatar(input) {
  if (!input.files[0]) return;
  const formData = new FormData();
  formData.append('avatar', input.files[0]);
  try {
    const r = await fetch('/profile/avatar', { method: 'POST', body: formData });
    const d = await r.json();
    if (d.success) {
      const img = document.getElementById('avatar-img');
      if (img.tagName === 'IMG') {
        img.src = d.avatarUrl;
      } else {
        // Era un div placeholder
        const parent = img.parentElement;
        const newImg = document.createElement('img');
        newImg.src = d.avatarUrl;
        newImg.id = 'avatar-img';
        newImg.className = 'w-full h-full object-cover';
        newImg.alt = 'Avatar';
        parent.replaceChild(newImg, img);
      }
    } else { alert(d.error || 'Upload failed'); }
  } catch(e) { alert('Network error'); }
}

// ── Banner Upload ────────────────────────────────────────────
async function uploadBanner(input) {
  if (!input.files[0]) return;
  const formData = new FormData();
  formData.append('banner', input.files[0]);
  try {
    const r = await fetch('/profile/banner', { method: 'POST', body: formData });
    const d = await r.json();
    if (d.success) {
      let img = document.querySelector('#profile-banner img');
      if (img) {
        img.src = d.bannerUrl;
      } else {
        const banner = document.getElementById('profile-banner');
        const newImg = document.createElement('img');
        newImg.src = d.bannerUrl;
        newImg.alt = 'Banner';
        newImg.className = 'w-full h-full object-cover brightness-75';
        banner.insertBefore(newImg, banner.firstChild);
      }
    } else { alert(d.error || 'Upload failed'); }
  } catch(e) { alert('Network error'); }
}
</script>
</body>
</html>
